{
  "name": "@pagosya/storefront-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Renders a storefront source snapshot into a sandboxed preview document (TypeScript source, compiled by the consuming Vite app)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pagosya/storefront-kit": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  }
}
