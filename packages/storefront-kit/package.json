{
  "name": "@pagosya/storefront-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Browser runtimes, page templates, fonts, and icons shipped inside every generated storefront",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./kit/*": "./kit/*"
  },
  "scripts": {
    "build": "node kit/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node kit/check-runtimes.mjs && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "lenis": "1.3.26",
    "lottie-web": "5.13.0",
    "motion": "13.1.1",
    "react": "19.2.6",
    "typescript": "^5.9.3"
  }
}
