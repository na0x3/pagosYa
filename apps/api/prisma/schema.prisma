  @@unique([storeId, name])
  @@index([storeId, isActive])
}

model CustomerSubscription {
  id             String    @id @default(cuid())
  merchantId     String
  storeId        String
  planId         String
  customerId     String?
  customerName   String
  customerEmail  String?
  customerPhone  String?
  amountOverride Int?
  nextAmountOverride Int?
  activeKey      String?   @unique
  status         String    @default("ACTIVE")
  startedAt      DateTime  @default(now())
  nextBillingAt  DateTime
  canceledAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeId, status, nextBillingAt])
  @@index([planId, status])
}

model SubscriptionInvoice {
  id             String    @id @default(cuid())
  subscriptionId String
  merchantId     String
  storeId        String
  periodStart    DateTime
  amount         Int
  currency       String    @default("BOB")
  status         String    @default("DUE")
  paymentIntentId String?
  dueAt          DateTime
  paidAt         DateTime?
  initialNoticeAt DateTime?
  lastReminderAt DateTime?
  reminderCount  Int       @default(0)
  createdAt      DateTime  @default(now())

  @@unique([subscriptionId, periodStart])
  @@index([storeId, status, dueAt])
}
