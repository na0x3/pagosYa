  allocationId String
  allocation   EventPromoterAllocation @relation(fields: [allocationId], references: [id])
  ticketTypeId String?
  ticketType   TicketType?             @relation(fields: [ticketTypeId], references: [id])
  admissionId  String?                 @unique
  admission    Admission?              @relation(fields: [admissionId], references: [id])
  guestName    String
  guestEmail   String?
  guestPhone   String?
