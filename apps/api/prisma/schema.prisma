generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SettlementMode {
  AGGREGATOR
  FACILITATOR
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ApiKeyMode {
  TEST
  LIVE
}

enum ApiKeyType {
  PUBLISHABLE
  SECRET
}

enum PaymentMethodType {
  CARD
  TIGO_MONEY
  BANK_TRANSFER
  QR
}

enum PaymentIntentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  PROCESSING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
}

enum TransactionType {
  AUTHORIZATION
  CAPTURE
  REFUND
  PAYOUT
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum LedgerAccount {
  RAIL_CLEARING
  MERCHANT_PAYABLE
  PAGOSYA_FEE_REVENUE
  RESERVE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum WebhookEventStatus {
  PENDING
  DELIVERED
  FAILED
}

enum ConsumerAffiliationStatus {
  ACTIVE
  REVOKED
}

enum OrderFulfillmentStatus {
  AWAITING_PAYMENT
  PAID
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum KycStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  PENDING
  EMITTED
  FAILED
}

enum PayoutStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum OpsRole {
  SUPPORT_AGENT
  SUPPORT_ADMIN
}

enum SupportCaseCategory {
  ACCOUNT_ACCESS
  PAYMENTS
  KYC
  PAYOUTS
  STORES
  OTHER
}

enum SupportCasePriority {
  NORMAL
  HIGH
  URGENT
}

enum SupportCaseStatus {
  PENDING
  SENT
  REVIEWED
  RESOLVED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  ACTIVE
  ENDED
  CANCELLED
}

enum EventPricingMode {
  SEATED
  GENERAL_ADMISSION
}

enum EventSeatStatus {
  AVAILABLE
  HELD
  SOLD
}

enum TicketTypeKind {
  GENERAL
  VIP
  EARLY_BIRD
  TABLE
  GUEST
  STAFF
  CUSTOM
}

enum TicketReservationStatus {
  RESERVED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum AdmissionSource {
  ONLINE
  CASH_DOOR
  PROMOTER
  COMPLIMENTARY
  ADMIN
  PARTNER
}

enum EventPaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  QR_PAYMENT
  ONLINE_GATEWAY
  COMPLIMENTARY
}

enum EventPaymentStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
  VOID

  @@map("EventOrderStatus")
}

enum AdmissionStatus {
  VALID
  ACTIVE
  REVOKED
  USED
  VOID
  CANCELLED

  @@map("EventTicketStatus")
}

enum AssignmentStatus {
  UNASSIGNED
  CLAIMED
}

enum BiometricEnrollmentStatus {
  NOT_REQUIRED
  PENDING
  ENROLLED
  FAILED
  DELETED
}

enum BiometricProvider {
  MOCK
  ZKTECO
  FUTURE_PROVIDER
}

enum BiometricIdentityStatus {
  ACTIVE
  REVOKED
  DELETED
  REQUIRES_REENROLLMENT
}

enum BiometricConsentScope {
  EVENT_ONLY
  REUSABLE
}

enum BiometricReenrollmentReason {
  ALGORITHM_INCOMPATIBLE
  POOR_ENROLLMENT
  CREDENTIAL_CORRUPT
  CUSTOMER_REQUESTED
  VENDOR_MIGRATION
  CONSENT_CHANGED
}

enum EventBiometricAuthorizationStatus {
  AUTHORIZED
  REVOKED
  EXPIRED
}

enum DevicePersonSyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  REMOVAL_PENDING
  REMOVED
}

enum PresenceStatus {
  NEVER_ENTERED
  OUTSIDE
  INSIDE
}

enum EventStaffRole {
  ORGANIZATION_ADMIN
  EVENT_MANAGER
  CASHIER
  DOOR_STAFF
  PROMOTER
  AUDITOR
}

enum AccessDeviceRole {
  ENTRY
  EXIT
  BIDIRECTIONAL
  ENROLLMENT
}

enum AccessDeviceStatus {
  ONLINE
  OFFLINE
  DEGRADED
  DISABLED
}

enum AccessDirection {
  ENTRY
  EXIT
  MANUAL_ENTRY
  MANUAL_EXIT
}

enum AccessDecision {
  ALLOW
  DENY
  IGNORED
}

enum BiometricDeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PromoterAllocationKind {
  COMPLIMENTARY
  DISCOUNTED
}

enum GuestListStatus {
  INVITED
  CLAIMED
  ENROLLED
  ENTERED
  CANCELLED
}

// A named pagosYa staff member allowed to review KYC — replaces a single
// shared INTERNAL_OPS_SECRET so every review decision is attributable to a
// specific, revocable person instead of "whoever had the secret."
model OpsUser {
  id                   String                  @id @default(cuid())
  name                 String
  email                String                  @unique
  hashedToken          String
  role                 OpsRole                 @default(SUPPORT_AGENT)
  revokedAt            DateTime?
  createdAt            DateTime                @default(now())
  kycReviews           MerchantKycSubmission[]
  createdSupportCases  SupportCase[]           @relation("SupportCaseCreator")
  assignedSupportCases SupportCase[]           @relation("SupportCaseAssignee")
  supportNotes         SupportCaseNote[]
}

// Generic append-only trail for sensitive ops actions (KYC review today;
// intentionally generic so other ops actions can log to it later without a
// schema change).
model AuditLogEntry {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String
  actorLabel String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// A durable support envelope. Sensitive account reads and actions are tied to
// one case so the audit trail records not only who accessed an account, but why.
model SupportCase {
  id                      String              @id @default(cuid())
  merchantId              String
  merchant                Merchant            @relation(fields: [merchantId], references: [id])
  createdByOpsUserId      String?
  createdByOpsUser        OpsUser?            @relation("SupportCaseCreator", fields: [createdByOpsUserId], references: [id])
  createdByMerchantUserId String?
  createdByMerchantUser   MerchantUser?       @relation("SupportCaseMerchantCreator", fields: [createdByMerchantUserId], references: [id])
  assignedToOpsUserId     String?
  assignedToOpsUser       OpsUser?            @relation("SupportCaseAssignee", fields: [assignedToOpsUserId], references: [id])
  category                SupportCaseCategory
  priority                SupportCasePriority @default(NORMAL)
  status                  SupportCaseStatus   @default(PENDING)
  summary                 String
  resolution              String?
  notes                   SupportCaseNote[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  closedAt                DateTime?

  @@index([merchantId, createdAt])
  @@index([status, updatedAt])
  @@index([assignedToOpsUserId, status])
  @@index([createdByMerchantUserId, createdAt])
}

model SupportCaseNote {
  id        String      @id @default(cuid())
  caseId    String
  case      SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  opsUserId String
  opsUser   OpsUser     @relation(fields: [opsUserId], references: [id])
  body      String
  createdAt DateTime    @default(now())

  @@index([caseId, createdAt])
}

model Merchant {
  id               String                    @id @default(cuid())
  name             String
  email            String                    @unique
  settlementMode   SettlementMode            @default(AGGREGATOR)
  status           MerchantStatus            @default(PENDING)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  apiKeys          ApiKey[]
  paymentIntents   PaymentIntent[]
  webhookEndpoints WebhookEndpoint[]
  kycSubmissions   MerchantKycSubmission[]
  invoicingProfile MerchantInvoicingProfile?
  invoices         Invoice[]
  payouts          Payout[]
  users            MerchantUser[]
  stores           Store[]
  mediaAssets      MediaAsset[]
  productStats     StoreProductStat[]
  storeLeads       StoreLead[]
  supportCases     SupportCase[]
  venues           Venue[]
  events           Event[]
  eventAttendees   Attendee[]
  eventStaff       EventStaffMembership[]
  eventOrders      AdmissionOrder[]
  eventAuditLogs   EventAuditLog[]
  visualTemplates  StoreVisualTemplate[]
}

// A human login for the merchant dashboard — deliberately separate from
// ApiKey. The dashboard must never need a merchant's secret key in the
// browser; this is what apps/merchant-dashboard authenticates with instead.
model MerchantUser {
  id                    String                        @id @default(cuid())
  merchantId            String
  merchant              Merchant                      @relation(fields: [merchantId], references: [id])
  email                 String                        @unique
  hashedPassword        String
  // Daily-login stars are user-scoped so signing into more than one store does
  // not multiply the same day's reward.
  dailyLoginStars       Int                           @default(0)
  lastDailyStarAt       DateTime?
  // Stable Google OpenID Connect subject. Email is display/contact data and
  // can change; provider identity must always be keyed by `sub`.
  googleSubject         String?                       @unique
  // Account deletion is intentionally a deactivation. Financial, tax,
  // fulfillment, support, and audit evidence stays attached to stable IDs.
  deletedAt             DateTime?
  // Null until the confirmation link is used. An unverified row doesn't
  // permanently claim its email — see MerchantUserService.signup for why.
  emailVerifiedAt       DateTime?
  createdAt             DateTime                      @default(now())
  sessions              MerchantSession[]
  verificationTokens    EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  supportCases          SupportCase[]                 @relation("SupportCaseMerchantCreator")
  progressCelebrations  MerchantProgressCelebration[]
  eventStaffMemberships EventStaffMembership[]
  cashShifts            CashShift[]
  eventAuditLogs        EventAuditLog[]
  manualAccessEvents    AccessEvent[]
  eventRefunds          EventRefund[]
  promoterProfile       PromoterProfile?
}

// Durable acknowledgement for a newly unlocked companion. This is scoped to
// a store because storefront sales and visits determine that store's XP.
model MerchantProgressCelebration {
  merchantUserId      String
  merchantUser        MerchantUser @relation(fields: [merchantUserId], references: [id], onDelete: Cascade)
  storeId             String
  store               Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lastCelebratedLevel Int          @default(-1)
  updatedAt           DateTime     @updatedAt

  @@id([merchantUserId, storeId])
  @@index([storeId])
}

// Single-use, short-lived proof that whoever called signup actually
// controls the email they claimed — closes the account-squatting/
// enumeration gap a bare email-uniqueness check would otherwise open.
model EmailVerificationToken {
  id             String       @id @default(cuid())
  merchantUserId String
  merchantUser   MerchantUser @relation(fields: [merchantUserId], references: [id])
  hashedToken    String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
  @@index([hashedToken])
}

// Single-use, short-lived (1h) password reset token. requestPasswordReset()
// always responds identically regardless of whether the email exists — same
// enumeration-safety reasoning as MerchantUserService.signup.
model PasswordResetToken {
  id             String       @id @default(cuid())
  merchantUserId String
  merchantUser   MerchantUser @relation(fields: [merchantUserId], references: [id])
  hashedToken    String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
}

// Short-lived, revocable dashboard session token (dash_...) — what
// MerchantAuthGuard accepts alongside a secret API key.
model MerchantSession {
  id              String       @id @default(cuid())
  merchantUserId  String
  merchantUser    MerchantUser @relation(fields: [merchantUserId], references: [id])
  merchantId      String
  hashedToken     String       @unique
  profileName     String       @default("Propietario")
  profileAvatarId Int          @default(1)
  isPrimary       Boolean      @default(false)
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())

  @@index([expiresAt])
  @@index([merchantUserId, revokedAt, expiresAt])
  @@index([merchantId, revokedAt, expiresAt])
}

// Buyer identity is deliberately separate from MerchantUser: a person may
// shop at and hold obligations with many unrelated pagosYa merchants.
model ConsumerUser {
  id                  String                           @id @default(cuid())
  name                String
  email               String                           @unique
  carnet              String                           @unique
  hashedPassword      String
  googleSubject       String?                          @unique
  deletedAt           DateTime?
  emailVerifiedAt     DateTime?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  sessions            ConsumerSession[]
  verificationTokens  ConsumerVerificationToken[]
  affiliations        ConsumerInstitutionAffiliation[]
  paymentIntents      PaymentIntent[]
  orders              StoreOrder[]
  eventAttendees      Attendee[]
  biometricIdentities BiometricIdentity[]
  biometricConsents   BiometricConsent[]
  enrollmentSessions  EnrollmentSession[]
}

model ConsumerSession {
  id             String       @id @default(cuid())
  consumerUserId String
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  hashedToken    String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([consumerUserId, expiresAt])
}

model ConsumerVerificationToken {
  id             String       @id @default(cuid())
  consumerUserId String
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  hashedToken    String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
}

model ConsumerInstitutionAffiliation {
  id             String                    @id @default(cuid())
  consumerUserId String
  consumerUser   ConsumerUser              @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status         ConsumerAffiliationStatus @default(ACTIVE)
  acceptedAt     DateTime                  @default(now())
  revokedAt      DateTime?

  @@unique([consumerUserId, storeId])
  @@index([storeId, status])
}

// NIT/branch/point-of-sale registration a merchant needs on file before
// pagosYa can emit a Factura Electrónica on their behalf. `cuis` is issued
// once per (nit, sucursal, puntoVenta); `cufd`/`cufdExpiresAt` cache SIN's
// daily invoicing code (valid ~24h — see InvoicingService/InvoiceEmissionWorker).
model MerchantInvoicingProfile {
  id                 String             @id @default(cuid())
  merchantId         String             @unique
  merchant           Merchant           @relation(fields: [merchantId], references: [id])
  nit                String
  razonSocial        String
  sucursal           Int                @default(0)
  puntoVenta         Int                @default(0)
  cuis               String?
  cuisIssuedAt       DateTime?
  cufd               String?
  cufdExpiresAt      DateTime?
  // General-purpose Factura Compra-Venta. Other sectors can be added later,
  // but activity compatibility must always come from synchronization.
  documentSectorCode Int                @default(1)
  siatCatalogs       SiatCatalogCache[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// SIAT requires catalog synchronization at least daily. Cache each catalog
// per taxpayer profile because activities and their product/sector relations
// are scoped to the merchant NIT, even where the underlying catalog is broad.
model SiatCatalogCache {
  id                 String                   @id @default(cuid())
  invoicingProfileId String
  invoicingProfile   MerchantInvoicingProfile @relation(fields: [invoicingProfileId], references: [id], onDelete: Cascade)
  catalog            String
  entries            Json
  syncedAt           DateTime                 @default(now())

  @@unique([invoicingProfileId, catalog])
  @@index([syncedAt])
}

// One Factura Electrónica per succeeded PaymentIntent. Created PENDING in the
// same transaction as the payment's success (transactional outbox, same
// pattern as WebhookEvent) and emitted asynchronously by InvoiceEmissionWorker
// — SIN's real service is external, can be slow/down, and needs retries.
model Invoice {
  id               String        @id @default(cuid())
  merchantId       String
  merchant         Merchant      @relation(fields: [merchantId], references: [id])
  paymentIntentId  String        @unique
  paymentIntent    PaymentIntent @relation(fields: [paymentIntentId], references: [id])
  amount           Int
  currency         String        @default("BOB")
  customerName     String        @default("SIN NOMBRE")
  customerDocument String        @default("0")
  status           InvoiceStatus @default(PENDING)
  cuf              String?
  cufd             String?
  attempts         Int           @default(0)
  nextRetryAt      DateTime?
  failureReason    String?
  emittedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([status, nextRetryAt])
}

// Payout is the payout-side analog of Transaction (which is always scoped to
// one PaymentIntent): a payout nets a merchant's *unpaid* MERCHANT_PAYABLE
// ledger balance across many PaymentIntents into one disbursement. Only ever
// created for AGGREGATOR merchants — FACILITATOR merchants' MERCHANT_PAYABLE
// entries are informational only, since the rail already settled funds
// straight to them; paying those out too would be sending money twice.
model Payout {
  id            String       @id @default(cuid())
  merchantId    String
  merchant      Merchant     @relation(fields: [merchantId], references: [id])
  amount        Int
  currency      String       @default("BOB")
  bankAccount   String
  status        PayoutStatus @default(PENDING)
  railReference String?
  failureReason String?
  attempts      Int          @default(0)
  nextRetryAt   DateTime?
  paidOutAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, nextRetryAt])
  @@index([merchantId, createdAt])
}

model MerchantKycSubmission {
  id                  String    @id @default(cuid())
  merchantId          String
  merchant            Merchant  @relation(fields: [merchantId], references: [id])
  legalName           String
  taxId               String
  legalRepName        String
  legalRepDocumentId  String
  payoutBankAccount   String
  status              KycStatus @default(PENDING_REVIEW)
  reviewNote          String?
  reviewedAt          DateTime?
  reviewedByOpsUserId String?
  reviewedByOpsUser   OpsUser?  @relation(fields: [reviewedByOpsUserId], references: [id])
  // Snapshot of the reviewer's name/email at review time — the audit record
  // shouldn't change retroactively if the OpsUser is later renamed/revoked.
  reviewedByLabel     String?
  createdAt           DateTime  @default(now())

  @@index([merchantId, createdAt])
}

model ApiKey {
  id           String     @id @default(cuid())
  merchantId   String
  merchant     Merchant   @relation(fields: [merchantId], references: [id])
  mode         ApiKeyMode
  type         ApiKeyType
  keyPrefix    String
  // Human-readable metadata only. The complete credential is returned once
  // at creation and is never stored in recoverable form.
  label        String?
  lastFour     String?
  hashedSecret String
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([keyPrefix])
}

model PaymentIntent {
  id                   String              @id @default(cuid())
  merchantId           String
  merchant             Merchant            @relation(fields: [merchantId], references: [id])
  consumerUserId       String?
  consumerUser         ConsumerUser?       @relation(fields: [consumerUserId], references: [id], onDelete: SetNull)
  amount               Int
  currency             String              @default("BOB")
  status               PaymentIntentStatus @default(REQUIRES_PAYMENT_METHOD)
  paymentMethodType    PaymentMethodType?
  paymentMethodId      String?
  paymentMethod        PaymentMethod?      @relation(fields: [paymentMethodId], references: [id])
  clientSecret         String              @unique
  livemode             Boolean             @default(false)
  description          String?
  metadata             Json?
  railId               String?
  confirmationAttempts Int                 @default(0)
  lastError            Json?
  customerName         String?
  customerDocument     String?
  // Buyer contact info, collected at checkout so the merchant can reach out
  // about this order — separate from customerDocument (tax ID, for invoicing).
  customerEmail        String?
  customerPhone        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  transactions         Transaction[]
  invoice              Invoice?
  debtRecords          DebtRecord[]
  storeOrder           StoreOrder?
  ticketReservation    TicketReservation?
  admissionOrder       AdmissionOrder?

  @@index([merchantId, createdAt])
  @@index([consumerUserId, createdAt])
}

model Venue {
  id         String         @id @default(cuid())
  merchantId String
  merchant   Merchant       @relation(fields: [merchantId], references: [id])
  name       String
  address    String?
  city       String         @default("La Paz")
  timezone   String         @default("America/La_Paz")
  capacity   Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  events     Event[]
  devices    AccessDevice[]

  @@index([merchantId, createdAt])
}

model Event {
  id                      String                        @id @default(cuid())
  merchantId              String
  merchant                Merchant                      @relation(fields: [merchantId], references: [id])
  storeId                 String?
  store                   Store?                        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  venueId                 String?
  venue                   Venue?                        @relation(fields: [venueId], references: [id])
  slug                    String                        @unique
  name                    String                        @map("title")
  description             String?
  publicityImageUrl       String                        @default("")
  venueName               String                        @default("")
  venueAddress            String?
  startsAt                DateTime
  endsAt                  DateTime?
  doorsOpenAt             DateTime?
  lastEntryAt             DateTime?
  capacity                Int?
  currency                String                        @default("BOB")
  pricingMode             EventPricingMode              @default(GENERAL_ADMISSION)
  timezone                String                        @default("America/La_Paz")
  status                  EventStatus                   @default(DRAFT)
  allowReentry            Boolean                       @default(true)
  biometricRequired       Boolean                       @default(true)
  retentionHours          Int                           @default(24)
  salesAtDoorEnabled      Boolean                       @default(true)
  onlineSalesEnabled      Boolean                       @default(true)
  entryGracePeriodMinutes Int                           @default(0)
  manualOverrideAllowed   Boolean                       @default(true)
  reservationMinutes      Int                           @default(10)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  ticketTypes             TicketType[]
  reservations            TicketReservation[]
  orders                  AdmissionOrder[]
  admissions              Admission[]
  attendees               Attendee[]
  consents                BiometricConsent[]
  biometricAuthorizations EventBiometricAuthorization[]
  devices                 AccessDevice[]
  accessEvents            AccessEvent[]
  accessAttempts          AccessAttempt[]
  cashShifts              CashShift[]
  staff                   EventStaffMembership[]
  promoterAllocations     EventPromoterAllocation[]
  guestList               GuestListEntry[]
  auditLogs               EventAuditLog[]
  enrollmentSessions      EnrollmentSession[]
  deletionJobs            BiometricDeletionJob[]
  legacySeats             EventSeat[]

  @@index([merchantId, startsAt])
  @@index([venueId, startsAt])
  @@index([status, startsAt])
}

model TicketType {
  id                   String                    @id @default(cuid())
  eventId              String
  event                Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind                 TicketTypeKind            @default(CUSTOM)
  name                 String
  price                Int
  currency             String                    @default("BOB")
  inventory            Int?                      @map("quantity")
  sortOrder            Int                       @default(0) @map("order")
  reservedQuantity     Int                       @default(0) @map("heldCount")
  soldQuantity         Int                       @default(0) @map("soldCount")
  salesStart           DateTime?
  salesEnd             DateTime?
  reentryAllowed       Boolean                   @default(true)
  capacityContribution Int                       @default(1)
  active               Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  reservationItems     TicketReservationItem[]
  admissions           Admission[]
  guestList            GuestListEntry[]
  promoterAllocations  EventPromoterAllocation[]
  legacyOrders         AdmissionOrder[]          @relation("LegacyOrderTicketType")

  @@unique([eventId, name])
  @@index([eventId, active])
  @@map("EventPriceStage")
}

model TicketReservation {
  id                       String                  @id @default(cuid())
  merchantId               String
  eventId                  String
  event                    Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status                   TicketReservationStatus @default(RESERVED)
  totalAmount              Int
  currency                 String                  @default("BOB")
  buyerName                String?
  buyerEmail               String?
  buyerPhone               String?
  managementTokenHash      String                  @unique
  managementTokenExpiresAt DateTime
  expiresAt                DateTime
  completedAt              DateTime?
  paymentIntentId          String?                 @unique
  paymentIntent            PaymentIntent?          @relation(fields: [paymentIntentId], references: [id])
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  items                    TicketReservationItem[]
  order                    AdmissionOrder?

  @@index([eventId, status, expiresAt])
  @@index([merchantId, createdAt])
}

model TicketReservationItem {
  id            String            @id @default(cuid())
  reservationId String
  reservation   TicketReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ticketTypeId  String
  ticketType    TicketType        @relation(fields: [ticketTypeId], references: [id])
  quantity      Int
  unitAmount    Int
  createdAt     DateTime          @default(now())

  @@unique([reservationId, ticketTypeId])
  @@index([ticketTypeId])
}

model AdmissionOrder {
  id                    String                      @id @default(cuid())
  merchantId            String
  merchant              Merchant                    @relation(fields: [merchantId], references: [id])
  eventId               String
  event                 Event                       @relation(fields: [eventId], references: [id])
  reservationId         String?                     @unique
  reservation           TicketReservation?          @relation(fields: [reservationId], references: [id])
  paymentIntentId       String?                     @unique
  paymentIntent         PaymentIntent?              @relation(fields: [paymentIntentId], references: [id])
  cashShiftId           String?
  cashShift             CashShift?                  @relation(fields: [cashShiftId], references: [id])
  source                AdmissionSource
  paymentMethod         EventPaymentMethod
  paymentStatus         EventPaymentStatus          @default(PENDING) @map("status")
  totalAmount           Int                         @map("amount")
  currency              String                      @default("BOB")
  buyerName             String?
  buyerEmail            String?
  buyerPhone            String?
  legacyTicketTypeId    String?                     @map("gaPriceStageId")
  legacyTicketType      TicketType?                 @relation("LegacyOrderTicketType", fields: [legacyTicketTypeId], references: [id])
  legacyQuantity        Int?                        @map("gaQuantity")
  legacyHoldExpiresAt   DateTime?                   @map("holdExpiresAt")
  managementTokenHash   String?                     @unique
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  admissions            Admission[]
  financialTransactions EventFinancialTransaction[]
  refunds               EventRefund[]

  @@index([merchantId, createdAt])
  @@index([eventId, source, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("EventOrder")
}

model Admission {
  id                        String                       @id @default(cuid())
  code                      String                       @unique @map("qrToken")
  orderId                   String                       @map("eventOrderId")
  order                     AdmissionOrder               @relation(fields: [orderId], references: [id])
  legacySeatId              String?                      @unique @map("eventSeatId")
  legacySeat                EventSeat?                   @relation(fields: [legacySeatId], references: [id])
  eventId                   String
  event                     Event                        @relation(fields: [eventId], references: [id])
  ticketTypeId              String?                      @map("eventPriceStageId")
  ticketType                TicketType?                  @relation(fields: [ticketTypeId], references: [id])
  attendeeId                String?
  attendee                  Attendee?                    @relation(fields: [attendeeId], references: [id])
  source                    AdmissionSource
  status                    AdmissionStatus              @default(ACTIVE)
  legacyLabel               String?                      @map("gaLabel")
  legacyUsedAt              DateTime?                    @map("usedAt")
  assignmentStatus          AssignmentStatus             @default(UNASSIGNED)
  biometricEnrollmentStatus BiometricEnrollmentStatus    @default(PENDING)
  presenceStatus            PresenceStatus               @default(NEVER_ENTERED)
  claimedAt                 DateTime?
  firstEnteredAt            DateTime?
  lastPresenceChangedAt     DateTime?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  assignments               AdmissionAssignment[]
  consents                  BiometricConsent[]
  biometricAuthorization    EventBiometricAuthorization?
  accessEvents              AccessEvent[]
  accessAttempts            AccessAttempt[]
  enrollmentSessions        EnrollmentSession[]
  guestListEntry            GuestListEntry?

  @@index([eventId, presenceStatus])
  @@index([eventId, status])
  @@index([attendeeId])
  @@index([orderId])
  @@index([ticketTypeId])
  @@map("EventTicket")
}

model EventSeat {
  id                    String          @id @default(cuid())
  eventId               String
  event                 Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label                 String
  section               String          @default("General")
  rowLabel              String
  seatNumber            Int
  x                     Int
  y                     Int
  price                 Int
  currency              String          @default("BOB")
  status                EventSeatStatus @default(AVAILABLE)
  heldByPaymentIntentId String?
  holdExpiresAt         DateTime?
  soldAt                DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  admission             Admission?

  @@unique([eventId, label])
  @@index([eventId, status])
  @@index([heldByPaymentIntentId])
}

model AdmissionAssignment {
  id             String    @id @default(cuid())
  admissionId    String
  admission      Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  attendeeId     String
  attendee       Attendee  @relation(fields: [attendeeId], references: [id])
  claimTokenHash String?   @unique
  expiresAt      DateTime?
  claimedAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([admissionId, createdAt])
  @@index([attendeeId, createdAt])
}

model Attendee {
  id                      String                        @id @default(cuid())
  merchantId              String
  merchant                Merchant                      @relation(fields: [merchantId], references: [id])
  eventId                 String
  event                   Event                         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  consumerUserId          String?
  consumerUser            ConsumerUser?                 @relation(fields: [consumerUserId], references: [id], onDelete: SetNull)
  displayName             String
  email                   String?
  phone                   String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  admissions              Admission[]
  assignments             AdmissionAssignment[]
  consents                BiometricConsent[]
  biometricAuthorizations EventBiometricAuthorization[]
  accessEvents            AccessEvent[]
  accessAttempts          AccessAttempt[]

  @@unique([eventId, consumerUserId])
  @@index([merchantId, createdAt])
  @@index([eventId, displayName])
  @@index([eventId, email])
  @@index([eventId, phone])
  @@index([consumerUserId])
}

model BiometricConsent {
  id                  String                        @id @default(cuid())
  eventId             String
  event               Event                         @relation(fields: [eventId], references: [id])
  attendeeId          String
  attendee            Attendee                      @relation(fields: [attendeeId], references: [id])
  admissionId         String
  admission           Admission                     @relation(fields: [admissionId], references: [id])
  consumerUserId      String?
  consumerUser        ConsumerUser?                 @relation(fields: [consumerUserId], references: [id], onDelete: SetNull)
  biometricIdentityId String?
  biometricIdentity   BiometricIdentity?            @relation("BiometricIdentityConsents", fields: [biometricIdentityId], references: [id])
  activeForIdentity   BiometricIdentity?            @relation("ActiveBiometricConsent")
  scope               BiometricConsentScope         @default(EVENT_ONLY)
  version             String
  purpose             String
  consentedAt         DateTime
  expiresAt           DateTime?
  revokedAt           DateTime?
  retentionUntil      DateTime?
  createdAt           DateTime                      @default(now())
  authorizations      EventBiometricAuthorization[]

  @@index([eventId, consentedAt])
  @@index([attendeeId, consentedAt])
  @@index([admissionId])
  @@index([consumerUserId, scope, revokedAt])
  @@index([biometricIdentityId, revokedAt])
}

model BiometricIdentity {
  id                         String                        @id @default(cuid())
  consumerUserId             String?
  consumerUser               ConsumerUser?                 @relation(fields: [consumerUserId], references: [id], onDelete: SetNull)
  provider                   BiometricProvider
  status                     BiometricIdentityStatus       @default(ACTIVE)
  reusableAcrossEvents       Boolean                       @default(false)
  activeConsentId            String?                       @unique
  activeConsent              BiometricConsent?             @relation("ActiveBiometricConsent", fields: [activeConsentId], references: [id])
  providerExternalId         String?
  algorithmVersion           String?
  encryptedVendorPayload     String?
  encryptedTemplateReference String?
  metadata                   Json?
  lastVerifiedAt             DateTime?
  reenrollmentReason         BiometricReenrollmentReason?
  revokedAt                  DateTime?
  deletedAt                  DateTime?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  consents                   BiometricConsent[]            @relation("BiometricIdentityConsents")
  credentials                BiometricCredential[]
  authorizations             EventBiometricAuthorization[]
  deviceMappings             DevicePersonMapping[]
  deletionJobs               BiometricDeletionJob[]

  @@index([consumerUserId, status, reusableAcrossEvents])
  @@index([provider, providerExternalId])
  @@index([status, updatedAt])
}

model BiometricCredential {
  id                         String            @id @default(cuid())
  biometricIdentityId        String
  biometricIdentity          BiometricIdentity @relation(fields: [biometricIdentityId], references: [id])
  provider                   BiometricProvider
  providerExternalId         String?
  algorithmVersion           String?
  encryptedVendorPayload     String?
  encryptedTemplateReference String?
  enrolledAt                 DateTime
  lastVerifiedAt             DateTime?
  deletedAt                  DateTime?
  metadata                   Json?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@index([biometricIdentityId, deletedAt])
  @@index([provider, providerExternalId])
}

model EventBiometricAuthorization {
  id                  String                            @id @default(cuid())
  eventId             String
  event               Event                             @relation(fields: [eventId], references: [id])
  admissionId         String                            @unique
  admission           Admission                         @relation(fields: [admissionId], references: [id])
  attendeeId          String
  attendee            Attendee                          @relation(fields: [attendeeId], references: [id])
  biometricIdentityId String
  biometricIdentity   BiometricIdentity                 @relation(fields: [biometricIdentityId], references: [id])
  consentId           String
  consent             BiometricConsent                  @relation(fields: [consentId], references: [id])
  status              EventBiometricAuthorizationStatus @default(AUTHORIZED)
  authorizedAt        DateTime                          @default(now())
  revokedAt           DateTime?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt

  @@unique([eventId, biometricIdentityId])
  @@index([eventId, status])
  @@index([attendeeId, status])
  @@index([biometricIdentityId, status])
}

model AccessDevice {
  id                   String                @id @default(cuid())
  merchantId           String
  venueId              String
  venue                Venue                 @relation(fields: [venueId], references: [id])
  eventId              String?
  event                Event?                @relation(fields: [eventId], references: [id])
  name                 String
  vendor               String                @default("ZKTeco")
  model                String                @default("SpeedFace-V5")
  serialNumber         String?
  ipAddress            String?
  port                 Int?
  role                 AccessDeviceRole
  status               AccessDeviceStatus    @default(OFFLINE)
  lastSeenAt           DateTime?
  firmwareVersion      String?
  faceCapacity         Int?
  algorithmVersion     String?
  providerCapabilities Json?
  configuration        Json?
  encryptedSecrets     String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  personMappings       DevicePersonMapping[]
  ingestedEvents       DeviceEventIngest[]
  accessEvents         AccessEvent[]
  accessAttempts       AccessAttempt[]

  @@unique([merchantId, serialNumber])
  @@index([eventId, role, status])
  @@index([venueId, status])
}

model DevicePersonMapping {
  id                  String                 @id @default(cuid())
  deviceId            String
  device              AccessDevice           @relation(fields: [deviceId], references: [id])
  eventId             String
  biometricIdentityId String
  biometricIdentity   BiometricIdentity      @relation(fields: [biometricIdentityId], references: [id])
  externalPersonId    String
  syncStatus          DevicePersonSyncStatus @default(PENDING)
  contentFingerprint  String?
  algorithmVersion    String?
  syncedAt            DateTime?
  lastAttemptedAt     DateTime?
  removedAt           DateTime?
  lastError           String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([deviceId, eventId, externalPersonId])
  @@unique([deviceId, eventId, biometricIdentityId])
  @@index([biometricIdentityId, syncStatus])
  @@index([eventId, syncStatus])
  @@index([externalPersonId])
}

model DeviceEventIngest {
  id                      String         @id @default(cuid())
  externalEventId         String         @unique
  deviceId                String
  device                  AccessDevice   @relation(fields: [deviceId], references: [id])
  occurredAt              DateTime
  eventType               String
  externalPersonId        String?
  matchConfidence         Float?
  livenessPassed          Boolean?
  rawVendorEventReference String?
  receivedAt              DateTime       @default(now())
  processedAt             DateTime?
  accessEventId           String?        @unique
  accessEvent             AccessEvent?   @relation(fields: [accessEventId], references: [id])
  accessAttemptId         String?        @unique
  accessAttempt           AccessAttempt? @relation(fields: [accessAttemptId], references: [id])

  @@index([deviceId, occurredAt])
  @@index([occurredAt])
}

model AccessEvent {
  id          String             @id @default(cuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id])
  deviceId    String?
  device      AccessDevice?      @relation(fields: [deviceId], references: [id])
  admissionId String
  admission   Admission          @relation(fields: [admissionId], references: [id])
  attendeeId  String
  attendee    Attendee           @relation(fields: [attendeeId], references: [id])
  actorUserId String?
  actorUser   MerchantUser?      @relation(fields: [actorUserId], references: [id])
  direction   AccessDirection
  decision    AccessDecision     @default(ALLOW)
  reason      String?
  occurredAt  DateTime
  createdAt   DateTime           @default(now())
  ingest      DeviceEventIngest?

  @@index([eventId, occurredAt])
  @@index([admissionId, occurredAt])
  @@index([attendeeId, occurredAt])
  @@index([deviceId, occurredAt])
}

model AccessAttempt {
  id               String             @id @default(cuid())
  eventId          String?
  event            Event?             @relation(fields: [eventId], references: [id])
  deviceId         String?
  device           AccessDevice?      @relation(fields: [deviceId], references: [id])
  admissionId      String?
  admission        Admission?         @relation(fields: [admissionId], references: [id])
  attendeeId       String?
  attendee         Attendee?          @relation(fields: [attendeeId], references: [id])
  direction        AccessDirection?
  decision         AccessDecision
  reason           String
  externalPersonId String?
  occurredAt       DateTime
  createdAt        DateTime           @default(now())
  ingest           DeviceEventIngest?

  @@index([eventId, occurredAt])
  @@index([admissionId, occurredAt])
  @@index([deviceId, occurredAt])
}

model EnrollmentSession {
  id             String                @id @default(cuid())
  eventId        String
  event          Event                 @relation(fields: [eventId], references: [id])
  admissionId    String
  admission      Admission             @relation(fields: [admissionId], references: [id])
  deviceId       String?
  consumerUserId String?
  consumerUser   ConsumerUser?         @relation(fields: [consumerUserId], references: [id], onDelete: SetNull)
  requestedScope BiometricConsentScope @default(EVENT_ONLY)
  codeHash       String                @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  failedAt       DateTime?
  createdAt      DateTime              @default(now())

  @@index([eventId, expiresAt])
  @@index([admissionId, expiresAt])
}

model BiometricDeletionJob {
  id                  String                  @id @default(cuid())
  eventId             String?
  event               Event?                  @relation(fields: [eventId], references: [id])
  biometricIdentityId String
  biometricIdentity   BiometricIdentity       @relation(fields: [biometricIdentityId], references: [id])
  status              BiometricDeletionStatus @default(PENDING)
  requestedById       String?
  reason              String
  requestedAt         DateTime                @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  failureReason       String?
  attempts            Int                     @default(0)

  @@index([status, requestedAt])
  @@index([eventId, status])
  @@index([biometricIdentityId, status])
}

model CashShift {
  id           String                      @id @default(cuid())
  eventId      String
  event        Event                       @relation(fields: [eventId], references: [id])
  cashierId    String
  cashier      MerchantUser                @relation(fields: [cashierId], references: [id])
  openedAt     DateTime                    @default(now())
  closedAt     DateTime?
  openingFloat Int
  expectedCash Int?
  declaredCash Int?
  difference   Int?
  orders       AdmissionOrder[]
  transactions EventFinancialTransaction[]

  @@index([eventId, openedAt])
  @@index([cashierId, openedAt])
}

model EventFinancialTransaction {
  id              String                      @id @default(cuid())
  eventId         String
  orderId         String
  order           AdmissionOrder              @relation(fields: [orderId], references: [id])
  cashShiftId     String?
  cashShift       CashShift?                  @relation(fields: [cashShiftId], references: [id])
  type            String
  paymentMethod   EventPaymentMethod
  status          EventPaymentStatus
  amount          Int
  currency        String                      @default("BOB")
  reason          String?
  actorUserId     String?
  adjustmentForId String?
  adjustmentFor   EventFinancialTransaction?  @relation("FinancialAdjustments", fields: [adjustmentForId], references: [id])
  adjustments     EventFinancialTransaction[] @relation("FinancialAdjustments")
  createdAt       DateTime                    @default(now())

  @@index([eventId, createdAt])
  @@index([cashShiftId, createdAt])
  @@index([orderId, createdAt])
}

model EventRefund {
  id          String         @id @default(cuid())
  orderId     String
  order       AdmissionOrder @relation(fields: [orderId], references: [id])
  amount      Int
  currency    String         @default("BOB")
  reason      String
  actorUserId String
  actorUser   MerchantUser   @relation(fields: [actorUserId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([orderId, createdAt])
}

model EventStaffMembership {
  id             String         @id @default(cuid())
  merchantId     String
  merchant       Merchant       @relation(fields: [merchantId], references: [id])
  eventId        String
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  merchantUserId String
  merchantUser   MerchantUser   @relation(fields: [merchantUserId], references: [id])
  role           EventStaffRole
  permissions    Json?
  revokedAt      DateTime?
