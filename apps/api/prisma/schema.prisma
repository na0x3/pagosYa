generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SettlementMode {
  AGGREGATOR
  FACILITATOR
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ApiKeyMode {
  TEST
  LIVE
}

enum ApiKeyType {
  PUBLISHABLE
  SECRET
}

enum PaymentMethodType {
  CARD
  TIGO_MONEY
  BANK_TRANSFER
  QR
}

enum PaymentIntentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  PROCESSING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
}

enum TransactionType {
  AUTHORIZATION
  CAPTURE
  REFUND
  PAYOUT
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum LedgerAccount {
  RAIL_CLEARING
  MERCHANT_PAYABLE
  PAGOSYA_FEE_REVENUE
  RESERVE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum WebhookEventStatus {
  PENDING
  DELIVERED
  FAILED
}

enum ConsumerAffiliationStatus {
  ACTIVE
  REVOKED
}

enum OrderFulfillmentStatus {
  AWAITING_PAYMENT
  PAID
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum KycStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  PENDING
  EMITTED
  FAILED
}

enum PayoutStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum OpsRole {
  SUPPORT_AGENT
  SUPPORT_ADMIN
}

enum SupportCaseCategory {
  ACCOUNT_ACCESS
  PAYMENTS
  KYC
  PAYOUTS
  STORES
  OTHER
}

enum SupportCasePriority {
  NORMAL
  HIGH
  URGENT
}

enum SupportCaseStatus {
  PENDING
  SENT
  REVIEWED
  RESOLVED
}

// A named pagosYa staff member allowed to review KYC — replaces a single
// shared INTERNAL_OPS_SECRET so every review decision is attributable to a
// specific, revocable person instead of "whoever had the secret."
model OpsUser {
  id                   String                  @id @default(cuid())
  name                 String
  email                String                  @unique
  hashedToken          String
  role                 OpsRole                 @default(SUPPORT_AGENT)
  revokedAt            DateTime?
  createdAt            DateTime                @default(now())
  kycReviews           MerchantKycSubmission[]
  createdSupportCases  SupportCase[]           @relation("SupportCaseCreator")
  assignedSupportCases SupportCase[]           @relation("SupportCaseAssignee")
  supportNotes         SupportCaseNote[]
}

// Generic append-only trail for sensitive ops actions (KYC review today;
// intentionally generic so other ops actions can log to it later without a
// schema change).
model AuditLogEntry {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String
  actorLabel String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// A durable support envelope. Sensitive account reads and actions are tied to
// one case so the audit trail records not only who accessed an account, but why.
model SupportCase {
  id                      String              @id @default(cuid())
  merchantId              String
  merchant                Merchant            @relation(fields: [merchantId], references: [id])
  createdByOpsUserId      String?
  createdByOpsUser        OpsUser?            @relation("SupportCaseCreator", fields: [createdByOpsUserId], references: [id])
  createdByMerchantUserId String?
  createdByMerchantUser   MerchantUser?       @relation("SupportCaseMerchantCreator", fields: [createdByMerchantUserId], references: [id])
  assignedToOpsUserId     String?
  assignedToOpsUser       OpsUser?            @relation("SupportCaseAssignee", fields: [assignedToOpsUserId], references: [id])
  category                SupportCaseCategory
  priority                SupportCasePriority @default(NORMAL)
  status                  SupportCaseStatus   @default(PENDING)
  summary                 String
  resolution              String?
  notes                   SupportCaseNote[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  closedAt                DateTime?

  @@index([merchantId, createdAt])
  @@index([status, updatedAt])
  @@index([assignedToOpsUserId, status])
  @@index([createdByMerchantUserId, createdAt])
}

model SupportCaseNote {
  id        String      @id @default(cuid())
  caseId    String
  case      SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  opsUserId String
  opsUser   OpsUser     @relation(fields: [opsUserId], references: [id])
  body      String
  createdAt DateTime    @default(now())

  @@index([caseId, createdAt])
}

model Merchant {
  id               String                    @id @default(cuid())
  name             String
  email            String                    @unique
  settlementMode   SettlementMode            @default(AGGREGATOR)
  status           MerchantStatus            @default(PENDING)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  apiKeys          ApiKey[]
  paymentIntents   PaymentIntent[]
  webhookEndpoints WebhookEndpoint[]
  kycSubmissions   MerchantKycSubmission[]
  invoicingProfile MerchantInvoicingProfile?
  invoices         Invoice[]
  payouts          Payout[]
  users            MerchantUser[]
  stores           Store[]
  mediaAssets      MediaAsset[]
  productStats     StoreProductStat[]
  storeLeads       StoreLead[]
  supportCases     SupportCase[]
}

// A human login for the merchant dashboard — deliberately separate from
// ApiKey. The dashboard must never need a merchant's secret key in the
// browser; this is what apps/merchant-dashboard authenticates with instead.
model MerchantUser {
  id                  String                   @id @default(cuid())
  merchantId          String
  merchant            Merchant                 @relation(fields: [merchantId], references: [id])
  email               String                   @unique
  hashedPassword      String
  // Daily-login stars are user-scoped so signing into more than one store does
  // not multiply the same day's reward.
  dailyLoginStars     Int                      @default(0)
  lastDailyStarAt     DateTime?
  // Stable Google OpenID Connect subject. Email is display/contact data and
  // can change; provider identity must always be keyed by `sub`.
  googleSubject       String?                  @unique
  // Account deletion is intentionally a deactivation. Financial, tax,
  // fulfillment, support, and audit evidence stays attached to stable IDs.
  deletedAt           DateTime?
  // Null until the confirmation link is used. An unverified row doesn't
  // permanently claim its email — see MerchantUserService.signup for why.
  emailVerifiedAt     DateTime?
  createdAt           DateTime                 @default(now())
  sessions            MerchantSession[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  supportCases        SupportCase[]            @relation("SupportCaseMerchantCreator")
  progressCelebrations MerchantProgressCelebration[]
}

// Durable acknowledgement for a newly unlocked companion. This is scoped to
// a store because storefront sales and visits determine that store's XP.
model MerchantProgressCelebration {
  merchantUserId      String
  merchantUser        MerchantUser @relation(fields: [merchantUserId], references: [id], onDelete: Cascade)
  storeId             String
  store               Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lastCelebratedLevel Int           @default(-1)
  updatedAt           DateTime      @updatedAt

  @@id([merchantUserId, storeId])
  @@index([storeId])
}

// Single-use, short-lived proof that whoever called signup actually
// controls the email they claimed — closes the account-squatting/
// enumeration gap a bare email-uniqueness check would otherwise open.
model EmailVerificationToken {
  id             String       @id @default(cuid())
  merchantUserId String
  merchantUser   MerchantUser @relation(fields: [merchantUserId], references: [id])
  hashedToken    String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
  @@index([hashedToken])
}

// Single-use, short-lived (1h) password reset token. requestPasswordReset()
// always responds identically regardless of whether the email exists — same
// enumeration-safety reasoning as MerchantUserService.signup.
model PasswordResetToken {
  id             String       @id @default(cuid())
  merchantUserId String
  merchantUser   MerchantUser @relation(fields: [merchantUserId], references: [id])
  hashedToken    String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
}

// Short-lived, revocable dashboard session token (dash_...) — what
// MerchantAuthGuard accepts alongside a secret API key.
model MerchantSession {
  id             String       @id @default(cuid())
  merchantUserId String
  merchantUser   MerchantUser @relation(fields: [merchantUserId], references: [id])
  merchantId     String
  hashedToken    String
  profileName    String       @default("Propietario")
  profileAvatarId Int         @default(1)
  isPrimary      Boolean      @default(false)
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
}

// Buyer identity is deliberately separate from MerchantUser: a person may
// shop at and hold obligations with many unrelated pagosYa merchants.
model ConsumerUser {
  id                 String                           @id @default(cuid())
  name               String
  email              String                           @unique
  carnet             String                           @unique
  hashedPassword     String
  googleSubject      String?                          @unique
  deletedAt          DateTime?
  emailVerifiedAt    DateTime?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  sessions           ConsumerSession[]
  verificationTokens ConsumerVerificationToken[]
  affiliations       ConsumerInstitutionAffiliation[]
  paymentIntents     PaymentIntent[]
  orders             StoreOrder[]
}

model ConsumerSession {
  id             String       @id @default(cuid())
  consumerUserId String
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  hashedToken    String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([consumerUserId, expiresAt])
}

model ConsumerVerificationToken {
  id             String       @id @default(cuid())
  consumerUserId String
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  hashedToken    String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
}

model ConsumerInstitutionAffiliation {
  id             String                    @id @default(cuid())
  consumerUserId String
  consumerUser   ConsumerUser              @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status         ConsumerAffiliationStatus @default(ACTIVE)
  acceptedAt     DateTime                  @default(now())
  revokedAt      DateTime?

  @@unique([consumerUserId, storeId])
  @@index([storeId, status])
}

// NIT/branch/point-of-sale registration a merchant needs on file before
// pagosYa can emit a Factura Electrónica on their behalf. `cuis` is issued
// once per (nit, sucursal, puntoVenta); `cufd`/`cufdExpiresAt` cache SIN's
// daily invoicing code (valid ~24h — see InvoicingService/InvoiceEmissionWorker).
model MerchantInvoicingProfile {
  id                 String             @id @default(cuid())
  merchantId         String             @unique
  merchant           Merchant           @relation(fields: [merchantId], references: [id])
  nit                String
  razonSocial        String
  sucursal           Int                @default(0)
  puntoVenta         Int                @default(0)
  cuis               String?
  cuisIssuedAt       DateTime?
  cufd               String?
  cufdExpiresAt      DateTime?
  // General-purpose Factura Compra-Venta. Other sectors can be added later,
  // but activity compatibility must always come from synchronization.
  documentSectorCode Int                @default(1)
  siatCatalogs       SiatCatalogCache[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// SIAT requires catalog synchronization at least daily. Cache each catalog
// per taxpayer profile because activities and their product/sector relations
// are scoped to the merchant NIT, even where the underlying catalog is broad.
model SiatCatalogCache {
  id                 String                   @id @default(cuid())
  invoicingProfileId String
  invoicingProfile   MerchantInvoicingProfile @relation(fields: [invoicingProfileId], references: [id], onDelete: Cascade)
  catalog            String
  entries            Json
  syncedAt           DateTime                 @default(now())

  @@unique([invoicingProfileId, catalog])
  @@index([syncedAt])
}

// One Factura Electrónica per succeeded PaymentIntent. Created PENDING in the
// same transaction as the payment's success (transactional outbox, same
// pattern as WebhookEvent) and emitted asynchronously by InvoiceEmissionWorker
// — SIN's real service is external, can be slow/down, and needs retries.
model Invoice {
  id               String        @id @default(cuid())
  merchantId       String
  merchant         Merchant      @relation(fields: [merchantId], references: [id])
  paymentIntentId  String        @unique
  paymentIntent    PaymentIntent @relation(fields: [paymentIntentId], references: [id])
  amount           Int
  currency         String        @default("BOB")
  customerName     String        @default("SIN NOMBRE")
  customerDocument String        @default("0")
  status           InvoiceStatus @default(PENDING)
  cuf              String?
  cufd             String?
  attempts         Int           @default(0)
  nextRetryAt      DateTime?
  failureReason    String?
  emittedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([status, nextRetryAt])
}

// Payout is the payout-side analog of Transaction (which is always scoped to
// one PaymentIntent): a payout nets a merchant's *unpaid* MERCHANT_PAYABLE
// ledger balance across many PaymentIntents into one disbursement. Only ever
// created for AGGREGATOR merchants — FACILITATOR merchants' MERCHANT_PAYABLE
// entries are informational only, since the rail already settled funds
// straight to them; paying those out too would be sending money twice.
model Payout {
  id            String       @id @default(cuid())
  merchantId    String
  merchant      Merchant     @relation(fields: [merchantId], references: [id])
  amount        Int
  currency      String       @default("BOB")
  bankAccount   String
  status        PayoutStatus @default(PENDING)
  railReference String?
  failureReason String?
  attempts      Int          @default(0)
  nextRetryAt   DateTime?
  paidOutAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, nextRetryAt])
  @@index([merchantId, createdAt])
}

model MerchantKycSubmission {
  id                  String    @id @default(cuid())
  merchantId          String
  merchant            Merchant  @relation(fields: [merchantId], references: [id])
  legalName           String
  taxId               String
  legalRepName        String
  legalRepDocumentId  String
  payoutBankAccount   String
  status              KycStatus @default(PENDING_REVIEW)
  reviewNote          String?
  reviewedAt          DateTime?
  reviewedByOpsUserId String?
  reviewedByOpsUser   OpsUser?  @relation(fields: [reviewedByOpsUserId], references: [id])
  // Snapshot of the reviewer's name/email at review time — the audit record
  // shouldn't change retroactively if the OpsUser is later renamed/revoked.
  reviewedByLabel     String?
  createdAt           DateTime  @default(now())

  @@index([merchantId, createdAt])
}

model ApiKey {
  id           String     @id @default(cuid())
  merchantId   String
  merchant     Merchant   @relation(fields: [merchantId], references: [id])
  mode         ApiKeyMode
  type         ApiKeyType
  keyPrefix    String
  // Human-readable metadata only. The complete credential is returned once
  // at creation and is never stored in recoverable form.
  label        String?
  lastFour     String?
  hashedSecret String
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([keyPrefix])
}

model PaymentIntent {
  id                   String              @id @default(cuid())
  merchantId           String
  merchant             Merchant            @relation(fields: [merchantId], references: [id])
  consumerUserId       String?
  consumerUser         ConsumerUser?       @relation(fields: [consumerUserId], references: [id], onDelete: SetNull)
  amount               Int
  currency             String              @default("BOB")
  status               PaymentIntentStatus @default(REQUIRES_PAYMENT_METHOD)
  paymentMethodType    PaymentMethodType?
  paymentMethodId      String?
  paymentMethod        PaymentMethod?      @relation(fields: [paymentMethodId], references: [id])
  clientSecret         String              @unique
  livemode             Boolean             @default(false)
  description          String?
  metadata             Json?
  railId               String?
  confirmationAttempts Int                 @default(0)
  lastError            Json?
  customerName         String?
  customerDocument     String?
  // Buyer contact info, collected at checkout so the merchant can reach out
  // about this order — separate from customerDocument (tax ID, for invoicing).
  customerEmail        String?
  customerPhone        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  transactions         Transaction[]
  invoice              Invoice?
  debtRecords          DebtRecord[]
  storeOrder           StoreOrder?

  @@index([merchantId, createdAt])
  @@index([consumerUserId, createdAt])
}

enum PaymentLinkStatus {
  ACTIVE
  ARCHIVED
}

enum DebtCollectionLinkStatus {
  ACTIVE
  ARCHIVED
}

enum DebtRecordStatus {
  PENDING
  PAID
}

enum CustomDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
}

// No-code entry point: a merchant with no developer creates one of these from
// the dashboard and gets a shareable storefront URL/QR. A merchant can run
// several independent Stores (e.g. two different shops under one account) —
// each has its own slug/branding/product catalog. The public checkout page
// (apps/checkout, /s/<slug>; legacy ?link=<slug>) turns a visit into a PaymentIntent via
// StoresService — same PaymentIntent/rail/ledger machinery as the full API
// path, just without requiring a merchant backend to call anything.
model Store {
  id                           String                           @id @default(cuid())
  merchantId                   String
  merchant                     Merchant                         @relation(fields: [merchantId], references: [id])
  slug                         String                           @unique
  debtPortalSlug               String?                          @unique
  name                         String
  // Short about/tagline text shown under the store name on the storefront.
  tagline                      String?
  // "/v1/uploads/<uuid>.<ext>" — path returned by POST /v1/uploads, not a data URL.
  logoUrl                      String?
  // Wide header image, separate from logoUrl (which stays small/square).
  bannerUrl                    String?
  // "#RRGGBB", validated at the DTO layer only.
  backgroundColor              String?
  // Storefront ground can be a single color or a merchant-authored two-color
  // gradient. The solid color remains the safe fallback for older clients.
  backgroundMode               String                           @default("solid")
  backgroundGradientStart      String                           @default("#f8fafc")
  backgroundGradientEnd        String                           @default("#e0e7ff")
  backgroundGradientAngle      Int                              @default(135)
  // "/v1/uploads/<uuid>.<ext>" — full-page storefront background photo.
  // Independent of backgroundColor: when set, the image is what's shown
  // (backgroundColor still renders behind it while the image loads / behind
  // any transparent areas), when unset backgroundColor (or the default) is
  // used as before.
  backgroundImageUrl           String?
  // Support channel shown to customers on the receipt/success screen — e.g.
  // for a refund request or an order question. Both optional and independent
  // (a merchant may only want to expose one).
  contactPhone                 String?
  contactEmail                 String?
  // Optional public contact form. The delivery address stays private and is
  // never returned by the public storefront endpoint.
  contactFormEnabled           Boolean                          @default(true)
  contactFormEmail             String?
  // Optional public location block fixed near the bottom of the storefront.
  // Only allow-listed map embed URLs reach this field (validated by the DTO);
  // merchant copy remains plain text and is escaped by the storefront.
  locationMapUrl               String?
  locationDescription          String?
  locationHighlight            String?
  // Ordered branches. Public copy and fulfillment capabilities live here;
  // product quantities remain on PaymentLink.locationStocks so payment
  // confirmation can decrement one branch atomically.
  locations                    Json                             @default("[]")
  // Long-form brand story ("Nuestra historia") rendered as its own storefront
  // section — multi-paragraph (blank-line separated), unlike the one-line tagline.
  aboutText                    String?
  aboutTitle                   String?
  aboutSubtitle                String?
  // Optional background photo for the "Nuestra historia" section. The section
  // remains plain and transparent when this is null.
  aboutImageUrl                String?
  catalogTitle                 String?
  catalogSubtitle              String?
  galleryTitle                 String?
  gallerySubtitle              String?
  // "#RRGGBB" brand accent for storefront highlights (chips, links, pay button,
  // title gradient). Null = pagosYa's default palette accent, per theme.
  accentColor                  String?
  // Curated storefront typography: "mono" (default) | "modern" |
  // "editorial" | "friendly". The dashboard itself always keeps pagosYa's
  // 0xProto Mono identity; this choice belongs only to the merchant storefront.
  fontStyle                    String                           @default("mono")
  // Corner treatment for the storefront's interactive elements:
  // "rounded" (default) | "pill" | "square". Validated at the DTO layer.
  buttonStyle                  String                           @default("rounded")
  // Storefront ground material for the "El Tablero" (hand-lettered price
  // board) visual world: "chalkboard" (default) | "kraft" | "painted".
  // Validated at the DTO layer.
  boardTexture                 String                           @default("chalkboard")
  // Short promo/notice line shown in a bar at the very top of the storefront.
  announcement                 String?
  // "static" (default) | "marquee". Speed is one full marquee pass in seconds.
  announcementMode             String                           @default("static")
  announcementSpeed            Int                              @default(18)
  // Merchant-controlled announcement presentation. Color is the strip
  // background; storefront code derives a contrasting ink color automatically.
  announcementSize             String                           @default("medium")
  announcementColor            String                           @default("#c58b3c")
  // Merchant-authored promotion dialog. The customer can dismiss it for the
  // current browser session; preview mode always renders it for editing.
  promotionEnabled             Boolean                          @default(false)
  // Optional visual shown at the top of the promotion dialog.
  promotionImageUrl            String?
  promotionTitle               String?
  promotionBody                String?
  promotionCtaLabel            String?
  promotionCtaUrl              String?
  // Ordered, merchant-authored storefront hero slides. JSON keeps this
  // lightweight customization atomic with the rest of the appearance editor;
  // every entry is validated by CreateStoreDto before it reaches Prisma.
  heroSlides                   Json                             @default("[]")
  // Every public content section appears exactly once. The dashboard edits
  // this array as an ordered list; empty sections simply do not render.
  contentOrder                 Json                             @default("[\"hero\",\"about\",\"products\",\"gallery\",\"motion\",\"contact\",\"links\"]")
  // Structural storefront composition selected by the merchant or visual AI:
  // cinematic | editorial | collage | catalog-first.
  layoutStyle                  String                           @default("cinematic")
  // Post-catalog visual experience selected by the merchant or visual AI:
  // coverflow | diagonal-marquee | story-scroller.
  experienceStyle              String                           @default("coverflow")
  // Opt-in merchant-authored animation section. AI proposals enable it, but
  // merchants preview the selected template before applying it.
  motionDuoEnabled             Boolean                          @default(false)
  // The selected animation template. Values are validated by CreateStoreDto.
  motionExperience             String                           @default("coverflow-carousel")
  // Ordered animation templates rendered inside the movable motion section.
  // motionExperience remains as a compatibility fallback for older clients.
  motionExperiences            Json                             @default("[\"coverflow-carousel\"]")
  // Named animation instances. Each owns its template, copy, and media and is
  // positioned independently through contentOrder as "animation-<id>".
  animations                   Json                             @default("[]")
  // Captioned brand/editorial photos, separate from product image galleries.
  // Validated JSON snapshot [{ imageUrl, caption }], maximum 8 entries.
  editorialGallery             Json                             @default("[]")
  // Button customization layers: corner shape lives in buttonStyle; these
  // control fill treatment, motion, and the customer-facing cart CTA copy.
  buttonVariant                String                           @default("solid")
  buttonMotion                 String                           @default("lift")
  cartButtonLabel              String                           @default("Ir a pagar")
  // "payment" opens pagosYa checkout; "whatsapp" sends the composed cart
  // to contactPhone; "external" sends the interested customer to a merchant
  // URL. The latter two never create a PaymentIntent and do not require NIT.
  checkoutMode                 String                           @default("payment")
  leadCaptureUrl               String?
  // Merchant-controlled cross-sell shelf inside the cart review. Recommendations
  // are explicitly selected by the merchant and always exclude cart items.
  cartRecommendationsEnabled   Boolean                          @default(true)
  cartRecommendationProductIds Json                             @default("[]")
  // Inventory quantities stay private unless the merchant explicitly opts in.
  // Sold-out state is still public so customers cannot add unavailable items.
  showLowStockToCustomers      Boolean                          @default(false)
  // Optional merchant-authored sales target shown and tracked by Yapi.
  salesGoalLabel               String?
  salesGoalAmount              Int?
  status                       StoreStatus                      @default(ACTIVE)
  // Incremented once per storefront page load (getStorePublic) — a simple
  // visit counter, not deduplicated per visitor. Good enough for "is anyone
  // looking at this store" without building real analytics infra.
  viewCount                    Int                              @default(0)
  createdAt                    DateTime                         @default(now())
  updatedAt                    DateTime                         @updatedAt
  paymentLinks                 PaymentLink[]
  categories                   Category[]
  links                        StoreLink[]
  mediaAssets                  MediaAsset[]
  visualProposals              StoreVisualProposal[]
  visualVersions               StoreVisualVersion[]
  customDomains                CustomDomain[]
  leads                        StoreLead[]
  debtCollectionLinks          DebtCollectionLink[]
  consumerAffiliations         ConsumerInstitutionAffiliation[]
  promoCodes                   PromoCode[]
  progressCelebrations         MerchantProgressCelebration[]
  @@index([merchantId, createdAt])
}

// A merchant-owned hostname that points at the existing hosted storefront.
// Ownership is proven with a unique DNS TXT value before public hostname
// resolution is enabled. TLS and edge routing stay deployment concerns; this
// row is the application-level hostname -> Store mapping.
model CustomDomain {
  id                String             @id @default(cuid())
  storeId           String
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  hostname          String             @unique
  status            CustomDomainStatus @default(PENDING)
  verificationToken String             @unique
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([storeId, createdAt])
}

// Payment status and fulfillment status are separate. Item snapshots survive
// later catalog edits and remain truthful in the buyer's history.
model StoreOrder {
  id              String                  @id @default(cuid())
  paymentIntentId String                  @unique
  paymentIntent   PaymentIntent           @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  consumerUserId  String?
  consumerUser    ConsumerUser?           @relation(fields: [consumerUserId], references: [id], onDelete: SetNull)
  merchantId      String
  storeId         String
  storeName       String
  fulfillmentLocationId      String?
  fulfillmentLocationName    String?
  fulfillmentMethod          String?
  fulfillmentReadyAt         DateTime?
  items           Json
  amount          Int
  currency        String                  @default("BOB")
  status          OrderFulfillmentStatus  @default(AWAITING_PAYMENT)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  statusEvents    StoreOrderStatusEvent[]

  @@index([consumerUserId, createdAt])
  @@index([merchantId, createdAt])
  @@index([storeId, createdAt])
}

model StoreOrderStatusEvent {
  id        String                 @id @default(cuid())
  orderId   String
  order     StoreOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderFulfillmentStatus
  createdAt DateTime               @default(now())

  @@index([orderId, createdAt])
}

// A company shares one collection URL; customers identify their own open
// balance with a carnet/CI and pay the server-owned amount through the same
// PaymentIntent rails used by storefront orders.
model DebtCollectionLink {
  id                String                   @id @default(cuid())
  storeId           String
  store             Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug              String                   @unique
  name              String
  notificationEmail String?
  currency          String                   @default("BOB")
  status            DebtCollectionLinkStatus @default(ACTIVE)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  debts             DebtRecord[]

  @@index([storeId, createdAt])
}

model DebtRecord {
  id                   String             @id @default(cuid())
  debtCollectionLinkId String
  debtCollectionLink   DebtCollectionLink @relation(fields: [debtCollectionLinkId], references: [id], onDelete: Cascade)
  customerDocument     String
  normalizedDocument   String
  customerName         String
  customerEmail        String?
  customerPhone        String?
  description          String?
  reference            String?
  amount               Int
  currency             String             @default("BOB")
  status               DebtRecordStatus   @default(PENDING)
  paymentIntentId      String?
  paymentIntent        PaymentIntent?     @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  paidAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([debtCollectionLinkId, normalizedDocument])
  @@index([debtCollectionLinkId, status])
  @@index([paymentIntentId])
}

// Contact requests created by lead-capture stores and zero-total carts. Paid
// orders continue to live in PaymentIntent; the merchant order feed combines
// both sources without pretending a lead was a completed sale.
model StoreLead {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String
  customerPhone String
  message       String?
  items         Json
  amount        Int
  currency      String   @default("BOB")
