  @@index([promoterId, createdAt])
}

model EventAuditLog {
  id          String        @id @default(cuid())
  actorUserId String?
  actorUser   MerchantUser? @relation(fields: [actorUserId], references: [id])
  merchantId  String
  merchant    Merchant      @relation(fields: [merchantId], references: [id])
  eventId     String?
  event       Event?        @relation(fields: [eventId], references: [id])
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime      @default(now())

  @@index([merchantId, createdAt])
  @@index([eventId, createdAt])
  @@index([entityType, entityId])
}

enum PaymentLinkStatus {
  ACTIVE
  ARCHIVED
}

enum DebtCollectionLinkStatus {
  ACTIVE
  ARCHIVED
}

enum DebtRecordStatus {
  PENDING
  PAID
}

enum CustomDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
}

// No-code entry point: a merchant with no developer creates one of these from
// the dashboard and gets a shareable storefront URL/QR. A merchant can run
// several independent Stores (e.g. two different shops under one account) —
// each has its own slug/branding/product catalog. The public checkout page
// (apps/checkout, /s/<slug>; legacy ?link=<slug>) turns a visit into a PaymentIntent via
// StoresService — same PaymentIntent/rail/ledger machinery as the full API
// path, just without requiring a merchant backend to call anything.
model Store {
  id                           String                           @id @default(cuid())
  // Private editor state. Public readers continue to use the Store columns.
  websiteDraft                 Json?
  websiteRevision              Int                              @default(0)
  websitePublishedRevision     Int                              @default(0)
  merchantId                   String
  merchant                     Merchant                         @relation(fields: [merchantId], references: [id])
  slug                         String                           @unique
  debtPortalSlug               String?                          @unique
  name                         String
  // Short about/tagline text shown under the store name on the storefront.
  tagline                      String?
  // "/v1/uploads/<uuid>.<ext>" — path returned by POST /v1/uploads, not a data URL.
  logoUrl                      String?
  // Wide header image, separate from logoUrl (which stays small/square).
  bannerUrl                    String?
  // "#RRGGBB", validated at the DTO layer only.
  backgroundColor              String?
  // Storefront ground can be a single color or a merchant-authored two-color
  // gradient. The solid color remains the safe fallback for older clients.
  backgroundMode               String                           @default("solid")
  backgroundGradientStart      String                           @default("#f8fafc")
  backgroundGradientEnd        String                           @default("#e0e7ff")
  backgroundGradientAngle      Int                              @default(135)
  // "/v1/uploads/<uuid>.<ext>" — full-page storefront background photo.
  // Independent of backgroundColor: when set, the image is what's shown
  // (backgroundColor still renders behind it while the image loads / behind
  // any transparent areas), when unset backgroundColor (or the default) is
  // used as before.
  backgroundImageUrl           String?
  // Support channel shown to customers on the receipt/success screen — e.g.
  // for a refund request or an order question. Both optional and independent
  // (a merchant may only want to expose one).
  contactPhone                 String?
  contactEmail                 String?
  // Optional public contact form. The delivery address stays private and is
  // never returned by the public storefront endpoint.
  contactFormEnabled           Boolean                          @default(true)
  contactFormEmail             String?
  contactTitle                 String?
  contactSubtitle              String?
  // Optional public location block. New stores place it at the bottom, and
  // merchants can later move it through the shared content-order editor.
  // Only allow-listed map embed URLs reach this field (validated by the DTO);
  // merchant copy remains plain text and is escaped by the storefront.
  locationMapUrl               String?
  locationDescription          String?
  locationHighlight            String?
  locationTitle                String?
  locationSubtitle             String?
  // Ordered branches. Public copy and fulfillment capabilities live here;
  // product quantities remain on PaymentLink.locationStocks so payment
  // confirmation can decrement one branch atomically.
  locations                    Json                             @default("[]")
  // Long-form brand story ("Nuestra historia") rendered as its own storefront
  // section — multi-paragraph (blank-line separated), unlike the one-line tagline.
  aboutText                    String?
  aboutTitle                   String?
  aboutSubtitle                String?
  // Optional background photo for the "Nuestra historia" section. The section
  // remains plain and transparent when this is null.
  aboutImageUrl                String?
  catalogTitle                 String?
  catalogSubtitle              String?
  galleryTitle                 String?
  gallerySubtitle              String?
  linksTitle                   String?
  // "#RRGGBB" brand accent for storefront highlights (chips, links, pay button,
  // title gradient). Null = pagosYa's default palette accent, per theme.
  accentColor                  String?
  // Curated storefront typography: "modern" (default) | "editorial" |
  // "friendly" | "classic" | "geometric". The dashboard itself always keeps pagosYa's
  // 0xProto Mono identity; this choice belongs only to the merchant storefront.
  fontStyle                    String                           @default("modern")
  // Corner treatment for the storefront's interactive elements:
  // "rounded" (default) | "pill" | "square". Validated at the DTO layer.
  buttonStyle                  String                           @default("rounded")
  // Storefront ground material for the "El Tablero" (hand-lettered price
  // board) visual world: "chalkboard" (default) | "kraft" | "painted".
  // Validated at the DTO layer.
  boardTexture                 String                           @default("chalkboard")
  // Short promo/notice line shown in a bar at the very top of the storefront.
  announcement                 String?
  // "static" (default) | "marquee". Speed is one full marquee pass in seconds.
  announcementMode             String                           @default("static")
  announcementSpeed            Int                              @default(18)
  // Merchant-controlled announcement presentation. Color is the strip
  // background; storefront code derives a contrasting ink color automatically.
  announcementSize             String                           @default("medium")
  announcementColor            String                           @default("#ffffff")
  // Independent lettering for the announcement strip. The font is selected
  // from the same curated storefront families; the effect is a bounded CSS
  // treatment with an accessible reduced-motion fallback.
  announcementFont             String                           @default("store")
  announcementEffect           String                           @default("none")
  // Merchant-authored promotion dialog. The customer can dismiss it for the
  // current browser session; preview mode always renders it for editing.
  promotionEnabled             Boolean                          @default(false)
  // Optional visual shown at the top of the promotion dialog.
  promotionImageUrl            String?
  promotionTitle               String?
  promotionBody                String?
  promotionCtaLabel            String?
  promotionCtaUrl              String?
  // Ordered, merchant-authored storefront hero slides. JSON keeps this
  // lightweight customization atomic with the rest of the appearance editor;
  // every entry is validated by CreateStoreDto before it reaches Prisma.
  heroSlides                   Json                             @default("[]")
  // Every public content section appears exactly once. The dashboard edits
  // this array as an ordered list; empty sections simply do not render.
  contentOrder                 Json                             @default("[\"animation-welcome\",\"hero\",\"about\",\"products\",\"gallery\",\"links\",\"contact\",\"location\"]")
  // Optional background colors keyed by contentOrder section id. Keeping this
  // separate from content lets the visual editor recolor a section without
  // rewriting its copy, media, or position.
  sectionBackgrounds           Json                             @default("{}")
  // Structural storefront composition selected by the merchant or visual AI:
  // cinematic | editorial | collage | catalog-first.
  layoutStyle                  String                           @default("cinematic")
  // Post-catalog visual experience selected by the merchant or visual AI:
  // coverflow | diagonal-marquee | story-scroller.
  experienceStyle              String                           @default("coverflow")
  // Opt-in merchant-authored animation section. AI proposals enable it, but
  // merchants preview the selected template before applying it.
  motionDuoEnabled             Boolean                          @default(true)
  // The selected animation template. Values are validated by CreateStoreDto.
  motionExperience             String                           @default("clarity-marquee")
  // Ordered animation templates rendered inside the movable motion section.
  // motionExperience remains as a compatibility fallback for older clients.
  motionExperiences            Json                             @default("[\"clarity-marquee\"]")
  // Named animation instances. Each owns its template, copy, and media and is
  // positioned independently through contentOrder as "animation-<id>".
  animations                   Json                             @default("[{\"id\":\"welcome\",\"name\":\"Bienvenida en movimiento\",\"type\":\"clarity-marquee\",\"media\":[]}]")
  // Captioned brand/editorial photos, separate from product image galleries.
  // Validated JSON snapshot [{ imageUrl, caption }], maximum 8 entries.
  editorialGallery             Json                             @default("[]")
  // Button customization layers: corner shape lives in buttonStyle; these
  // control fill treatment, motion, and the customer-facing cart CTA copy.
  buttonVariant                String                           @default("solid")
  buttonMotion                 String                           @default("lift")
  cartButtonLabel              String                           @default("Ir a pagar")
  // Versioned, bounded document produced by the AI site director. It controls
  // composition and art direction while catalog, cart, contact and checkout
  // remain trusted pagosYa components. Null keeps legacy stores unchanged.
  siteDocument                 Json?
  // Stable ids of sections the merchant wants preserved across AI runs.
  // Kept outside siteDocument so renderer state stays purely presentational.
  visualSectionLocks           Json                             @default("[]")
  // "payment" opens pagosYa checkout; "whatsapp" sends the composed cart
  // to contactPhone; "external" sends the interested customer to a merchant
  // URL. The latter two never create a PaymentIntent and do not require NIT.
  checkoutMode                 String                           @default("payment")
  leadCaptureUrl               String?
  // Merchant-controlled cross-sell shelf inside the cart review. Recommendations
  // are explicitly selected by the merchant and always exclude cart items.
  cartRecommendationsEnabled   Boolean                          @default(true)
  cartRecommendationProductIds Json                             @default("[]")
  // Inventory quantities stay private unless the merchant explicitly opts in.
  // Sold-out state is still public so customers cannot add unavailable items.
  showLowStockToCustomers      Boolean                          @default(false)
  // Optional merchant-authored sales target shown and tracked by Yapi.
  salesGoalLabel               String?
  salesGoalAmount              Int?
  status                       StoreStatus                      @default(ACTIVE)
  // Incremented once per storefront page load (getStorePublic) — a simple
  // visit counter, not deduplicated per visitor. Good enough for "is anyone
  // looking at this store" without building real analytics infra.
  viewCount                    Int                              @default(0)
  createdAt                    DateTime                         @default(now())
  updatedAt                    DateTime                         @updatedAt
  paymentLinks                 PaymentLink[]
  categories                   Category[]
  links                        StoreLink[]
  mediaAssets                  MediaAsset[]
  visualProposals              StoreVisualProposal[]
  visualVersions               StoreVisualVersion[]
  visualSignatures             StoreVisualSignature[]
  sourceProject                StoreSourceProject?
  agentThread                  StoreAgentThread?
  customDomains                CustomDomain[]
  leads                        StoreLead[]
  newsletterSubscribers        StoreNewsletterSubscriber[]
  debtCollectionLinks          DebtCollectionLink[]
  consumerAffiliations         ConsumerInstitutionAffiliation[]
  promoCodes                   PromoCode[]
  progressCelebrations         MerchantProgressCelebration[]
  events                       Event[]

  @@index([merchantId, createdAt])
}

// A merchant-owned hostname that points at the existing hosted storefront.
// Ownership is proven with a unique DNS TXT value before public hostname
// resolution is enabled. TLS and edge routing stay deployment concerns; this
// row is the application-level hostname -> Store mapping.
model CustomDomain {
  id                String             @id @default(cuid())
  storeId           String
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  hostname          String             @unique
  status            CustomDomainStatus @default(PENDING)
  verificationToken String             @unique
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([storeId, createdAt])
}

// Payment status and fulfillment status are separate. Item snapshots survive
// later catalog edits and remain truthful in the buyer's history.
model StoreOrder {
  id                      String                  @id @default(cuid())
  paymentIntentId         String                  @unique
  paymentIntent           PaymentIntent           @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  consumerUserId          String?
  consumerUser            ConsumerUser?           @relation(fields: [consumerUserId], references: [id], onDelete: SetNull)
  merchantId              String
  storeId                 String
  storeName               String
  fulfillmentLocationId   String?
  fulfillmentLocationName String?
  fulfillmentMethod       String?
  fulfillmentReadyAt      DateTime?
  items                   Json
  amount                  Int
  currency                String                  @default("BOB")
  status                  OrderFulfillmentStatus  @default(AWAITING_PAYMENT)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  statusEvents            StoreOrderStatusEvent[]

  @@index([consumerUserId, createdAt])
  @@index([merchantId, createdAt])
  @@index([storeId, createdAt])
}

model StoreOrderStatusEvent {
  id        String                 @id @default(cuid())
  orderId   String
  order     StoreOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderFulfillmentStatus
  createdAt DateTime               @default(now())

  @@index([orderId, createdAt])
}

// A company shares one collection URL; customers identify their own open
// balance with a carnet/CI and pay the server-owned amount through the same
// PaymentIntent rails used by storefront orders.
model DebtCollectionLink {
  id                String                   @id @default(cuid())
  storeId           String
  store             Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug              String                   @unique
  name              String
  notificationEmail String?
  currency          String                   @default("BOB")
  status            DebtCollectionLinkStatus @default(ACTIVE)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  debts             DebtRecord[]

  @@index([storeId, createdAt])
}

model DebtRecord {
  id                   String             @id @default(cuid())
  debtCollectionLinkId String
  debtCollectionLink   DebtCollectionLink @relation(fields: [debtCollectionLinkId], references: [id], onDelete: Cascade)
  customerDocument     String
  normalizedDocument   String
  customerName         String
  customerEmail        String?
  customerPhone        String?
  description          String?
  reference            String?
  amount               Int
  currency             String             @default("BOB")
  status               DebtRecordStatus   @default(PENDING)
  paymentIntentId      String?
  paymentIntent        PaymentIntent?     @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  paidAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([debtCollectionLinkId, normalizedDocument])
  @@index([debtCollectionLinkId, status])
  @@index([paymentIntentId])
}

// Contact requests created by lead-capture stores and zero-total carts. Paid
// orders continue to live in PaymentIntent; the merchant order feed combines
// both sources without pretending a lead was a completed sale.
model StoreLead {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String
  customerPhone String
  message       String?
  items         Json
  amount        Int
  currency      String   @default("BOB")
  createdAt     DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([storeId, createdAt])
}

// Consent is store-scoped and deduplicated by normalized email. This keeps
// newsletter signups separate from sales leads and contact requests.
model StoreNewsletterSubscriber {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email])
  @@index([storeId, createdAt])
}

enum MediaAssetKind {
  ORIGINAL
  AI_DERIVED
}

// Upload ownership and lineage live in the database even when the bytes move
// from local disk to object storage. Original merchant files are never
// overwritten by AI output; derived files point back to their source.
model MediaAsset {
  id            String         @id @default(cuid())
  merchantId    String
  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  storeId       String?
  store         Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  url           String         @unique
  storageKey    String         @unique
  kind          MediaAssetKind @default(ORIGINAL)
  mimeType      String
  byteSize      Int
  parentAssetId String?
  parentAsset   MediaAsset?    @relation("MediaAssetLineage", fields: [parentAssetId], references: [id], onDelete: SetNull)
  derivatives   MediaAsset[]   @relation("MediaAssetLineage")
  createdAt     DateTime       @default(now())

  @@index([merchantId, createdAt])
  @@index([storeId, createdAt])
}

enum VisualProposalStatus {
  READY
  APPLIED
  DISMISSED
}

enum StoreAgentMessageRole {
  USER
  ASSISTANT
}

// The thread is owned by the store rather than by an AI provider. This makes
// the merchant's working conversation durable even when models change.
model StoreAgentThread {
  id        String              @id @default(cuid())
  storeId   String              @unique
  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages  StoreAgentMessage[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model StoreAgentMessage {
  id         String                @id @default(cuid())
  threadId   String
  thread     StoreAgentThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role       StoreAgentMessageRole
  channel    String                @default("website")
  content    String
  proposalId String?
  proposal   StoreVisualProposal?  @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  metadata   Json                  @default("{}")
  createdAt  DateTime              @default(now())

  @@index([threadId, createdAt])
  @@index([threadId, channel, createdAt])
  @@index([proposalId])
}

// A proposal stores only the bounded storefront configuration accepted by the
// API. It never stores or executes model-generated HTML, CSS, or JavaScript.
model StoreVisualProposal {
  id              String               @id @default(cuid())
  storeId         String
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title           String
  rationale       String
  provider        String
  status          VisualProposalStatus @default(READY)
  config          Json
  baseWebsiteRevision Int?
  sourceAssetUrls Json                 @default("[]")
  generatedUrls   Json                 @default("[]")
  appliedAt       DateTime?
  createdAt       DateTime             @default(now())
  agentMessages   StoreAgentMessage[]

  @@index([storeId, createdAt])
}

// Independent storefront source is private, immutable per revision, and never
// evaluated by the API or the legacy document renderer.
model StoreSourceProject {
  storeId   String @id
  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  revision  Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  StoreSourceVersion[]
}

model StoreSourceVersion {
  storeId      String
  project      StoreSourceProject @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  revision     Int
  label        String
  digest       String
  snapshot     Json
  restoredFrom Int?
  createdAt    DateTime @default(now())

  @@id([storeId, revision])
}

// Snapshots are created before applying an AI proposal or restoring an older
// version, making every visual change reversible without touching products.
model StoreVisualVersion {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label     String
  source    String
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

// A reusable creative recipe. The JSON is deliberately content-free: it may
// contain weighted visual axes, section structures, and semantic media roles,
// but never product ids, merchant copy, or asset URLs.
model StoreVisualTemplate {
  id               String   @id @default(cuid())
  merchantId       String
  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name             String
  sourceProposalId String?
  recipe           Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([merchantId, createdAt])
}

// Content-free structural history used by the originality gate. Features
// describe topology, type roles, geometry, rhythm, media placement and motion;
// this table never contains merchant copy, product ids, or asset URLs.
model StoreVisualSignature {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceType  String
  sourceId    String?
  fingerprint String
  signature   Json
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([sourceType, sourceId])
  @@index([fingerprint])
}

// Merchant-defined buttons rendered under the storefront header — social
// profiles, a catalog PDF, a map pin, anything the merchant wants to link out
// to. Replaced wholesale via PUT /v1/stores/:id/links (order = sortOrder), so
// there's no per-row CRUD.
model StoreLink {
  id        String @id @default(cuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label     String
  // http(s) only, enforced at the DTO layer — these render as clickable
  // buttons on a customer-facing page, so no javascript:/data: schemes.
  url       String
  sortOrder Int    @default(0)

  @@index([storeId, sortOrder])
}

enum StoreStatus {
  ACTIVE
  ARCHIVED
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

// Shareable, store-scoped codes. FIXED values use minor currency units,
// matching every other amount in the payment domain.
model PromoCode {
  id            String            @id @default(cuid())
  storeId       String
  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String
  discountType  PromoDiscountType
  discountValue Int
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([storeId, code])
  @@index([storeId, isActive, createdAt])
}

// Groups a Store's products into sections on the storefront (e.g. "Bebidas",
// "Postres") — optional per product; uncategorized products still render,
// just outside any section.
model Category {
  id           String        @id @default(cuid())
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  bannerUrl    String?
  highlights   String[]      @default([])
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  paymentLinks PaymentLink[]

  @@index([storeId, sortOrder])
}

// A product within a Store's catalog.
model PaymentLink {
  id                 String            @id @default(cuid())
  storeId            String
  store              Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name               String
  description        String?
  // "/v1/uploads/<uuid>.<ext>" paths returned by POST /v1/uploads — first
  // entry is the cover photo, rest render as a gallery. Replaces the old
  // single `imageUrl` column (see migration 20260807150000_store_catalog_v2).
  imageUrls          String[]          @default([])
  // CSS object-position values ("x% y%") aligned by index with imageUrls.
  // Missing entries fall back to centered, preserving every existing product.
  imagePositions     String[]          @default([])
  // Free-form small labels the merchant types, e.g. "Nuevo", "Agotado" —
  // rendered as pill badges on the storefront. Not a controlled vocabulary.
  tags               String[]          @default([])
  // Ordered product ids chosen by the merchant for the recommendation shelf
  // on this product's detail page. The service validates that every id belongs
  // to the same store and never allows the product to recommend itself.
  recommendedProductIds String[]        @default([])
  // Remaining units, null = not tracked (unlimited, today's behavior for
  // every existing product). When set, the storefront caps cart quantity to
  // it and cart-checkout/payment success enforce it server-side.
  stock              Int?
  // { [storeLocationId]: number | null }; null means unlimited at that
  // branch. When branches are configured, stock is the derived aggregate.
  locationStocks     Json              @default("{}")
  // "#RRGGBB" product color swatch (e.g. a T-shirt color), validated at the DTO layer only.
  color              String?
  // Optional purchasable choices such as Pequeña/Grande. Stored as a small
  // validated JSON snapshot [{ id, name, amount, stock }]. A missing stock
  // field preserves the earlier shared-product-stock behavior; null means the
  // option is unlimited, and an integer is decremented atomically in Postgres.
  variants           Json              @default("[]")
  // Additive product modifiers [{ id, name, amount, required }]. Their amount
  // is added server-side after validating the customer's selected ids.
  extras             Json              @default("[]")
  amount             Int
  currency           String            @default("BOB")
  // Optional percentage campaign. Pricing only applies it while the server
  // clock is inside this closed-open window [startsAt, endsAt).
  discountPercent    Int?
  discountStartsAt   DateTime?
  discountEndsAt     DateTime?
  // Merchant/PagosYa SKU. This is codigoProducto in the invoice XML and is
  // deliberately separate from SIN's generic product classification.
  codigoProducto     String?
  // Taxpayer activity selected from sincronizarActividades.
  actividadEconomica String?
  // SIN generic product/service code, synchronized for actividadEconomica.
  codigoProductoSin  String?
  // SIAT unit classifier from sincronizarParametricaUnidadMedida.
  unidadMedida       Int?
  status             PaymentLinkStatus @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([storeId, codigoProducto])
  @@index([storeId, createdAt])
  @@index([categoryId])
}

// Persisted checkout totals keep storefront sorting and finance summaries
// bounded as payment history grows. storeId/paymentLinkId are snapshots, not
// foreign keys, so deleting a storefront never erases its financial history.
model StoreProductStat {
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  storeId       String
  paymentLinkId String
  productName   String
  quantity      Int      @default(0)
  revenue       Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@id([storeId, paymentLinkId])
  @@index([merchantId, quantity])
  @@index([storeId, quantity])
}

model PaymentMethod {
  id             String            @id @default(cuid())
  merchantId     String
  type           PaymentMethodType
  token          String
  last4          String?
  brand          String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  paymentIntents PaymentIntent[]

  @@unique([merchantId, token])
}

model Transaction {
  id              String            @id @default(cuid())
  paymentIntentId String
  paymentIntent   PaymentIntent     @relation(fields: [paymentIntentId], references: [id])
  type            TransactionType
  railId          String
  amount          Int
  status          TransactionStatus
  railReference   String?
  rawResponse     Json?
  createdAt       DateTime          @default(now())
  ledgerEntries   LedgerEntry[]

  @@index([paymentIntentId])
}

model LedgerEntry {
  id                 String          @id @default(cuid())
  transactionGroupId String
  transactionId      String?
  transaction        Transaction?    @relation(fields: [transactionId], references: [id])
  merchantId         String?
  account            LedgerAccount
  direction          LedgerDirection
  amount             Int
  currency           String          @default("BOB")
  createdAt          DateTime        @default(now())

  @@index([transactionGroupId])
  @@index([merchantId, account])
}

model WebhookEndpoint {
  id            String         @id @default(cuid())
  merchantId    String
  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  url           String
  secret        String
  enabledEvents String[]
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  events        WebhookEvent[]
}

model WebhookEvent {
  id                 String             @id @default(cuid())
  merchantId         String
  webhookEndpointId  String
  webhookEndpoint    WebhookEndpoint    @relation(fields: [webhookEndpointId], references: [id])
  eventType          String
  payload            Json
  status             WebhookEventStatus @default(PENDING)
  attempts           Int                @default(0)
  nextRetryAt        DateTime?
  lastAttemptAt      DateTime?
  lastResponseStatus Int?
  createdAt          DateTime           @default(now())

  @@index([status, nextRetryAt])
}

model IdempotencyKey {
  id             String    @id @default(cuid())
  merchantId     String
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  status         String    @default("IN_PROGRESS")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@unique([merchantId, key])
}

// Merchant operations hub ----------------------------------------------------
// These records deliberately retain merchantId/storeId snapshots instead of
// Prisma relations. The operational tools must remain queryable even when a
// storefront is archived, while the migration still installs database-level
// foreign keys where erasing the parent is safe.

model BusinessCustomer {
  id               String    @id @default(cuid())
  merchantId       String
  storeId          String
  name             String
  email            String?
  phone            String?
  document         String?
  tags             String[]  @default([])
  marketingConsent Boolean   @default(false)
  loyaltyPoints    Int       @default(0)
  lifetimeValue    Int       @default(0)
  orderCount       Int       @default(0)
  lastOrderAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([storeId, email])
  @@index([merchantId, updatedAt])
  @@index([storeId, loyaltyPoints])
}

model CustomerLoyaltyEntry {
  id         String   @id @default(cuid())
  merchantId String
  storeId    String
  customerId String
  points     Int
  reason     String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([storeId, createdAt])
}

model MerchantAutomation {
  id         String    @id @default(cuid())
  merchantId String
  storeId    String
  name       String
  kind       String
  channel    String    @default("EMAIL")
  delayHours Int       @default(24)
  subject    String?
  message    String
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([storeId, isActive, kind])
}

model AutomationDelivery {
  id            String    @id @default(cuid())
  automationId  String
  merchantId    String
  storeId       String
  recipient     String
  sourceType    String
  sourceId      String
  status        String    @default("DELIVERED")
  failureReason String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@unique([automationId, sourceType, sourceId])
  @@index([storeId, createdAt])
}

model DeliveryZone {
  id               String   @id @default(cuid())
  merchantId       String
  storeId          String
  name             String
  fee              Int
  minimumOrder     Int      @default(0)
  radiusKm         Float?
  estimatedMinutes Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId, isActive])
}

model Courier {
  id         String   @id @default(cuid())
  merchantId String
  storeId    String
  name       String
  phone      String?
  vehicle    String?
  status     String   @default("AVAILABLE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storeId, status])
}

model DeliveryAssignment {
  id          String    @id @default(cuid())
  merchantId  String
  storeId     String
  orderId     String    @unique
  courierId   String?
  zoneId      String?
  status      String    @default("UNASSIGNED")
  address     String?
  latitude    Float?
  longitude   Float?
  fee         Int       @default(0)
  notes       String?
  estimatedAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([storeId, status, createdAt])
  @@index([courierId, status])
}

model Supplier {
  id          String   @id @default(cuid())
  merchantId  String
  storeId     String
  name        String
  contactName String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId, updatedAt])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  merchantId  String
  storeId     String
  supplierId  String
  status      String    @default("DRAFT")
  currency    String    @default("BOB")
  expectedAt  DateTime?
  receivedAt  DateTime?
  totalAmount Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([storeId, status, createdAt])
  @@index([supplierId, createdAt])
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  paymentLinkId    String?
  sku              String?
  name             String
  quantity         Int
  unitCost         Int
  receivedQuantity Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([paymentLinkId])
}

model InventoryMovement {
  id            String   @id @default(cuid())
  merchantId    String
  storeId       String
  paymentLinkId String
  quantityDelta Int
  stockAfter    Int?
  reason        String
  sourceType    String
  sourceId      String?
  createdAt     DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([paymentLinkId, createdAt])
}

model ReconciliationImport {
  id              String    @id @default(cuid())
  merchantId      String
  storeId         String
  source          String
  currency        String    @default("BOB")
  totalAmount     Int
  matchedAmount   Int       @default(0)
  unmatchedAmount Int       @default(0)
  status          String    @default("PROCESSING")
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([storeId, createdAt])
}

model ReconciliationEntry {
  id            String   @id @default(cuid())
  importId      String
  externalId    String
  occurredAt    DateTime
  amount        Int
  description   String?
  railReference String?
  transactionId String?
  status        String   @default("UNMATCHED")
  createdAt     DateTime @default(now())

  @@unique([importId, externalId])
  @@index([importId, status])
  @@index([railReference])
}

model CustomerFavorite {
  id             String   @id @default(cuid())
  consumerUserId String
  storeId        String
  paymentLinkId  String
  createdAt      DateTime @default(now())

  @@unique([consumerUserId, paymentLinkId])
  @@index([consumerUserId, createdAt])
}

model CustomerReturnRequest {
  id             String    @id @default(cuid())
  merchantId     String
  storeId        String
  orderId        String
  consumerUserId String?
  reason         String
  details        String?
  status         String    @default("REQUESTED")
  resolution     String?
  dueAt          DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeId, status, createdAt])
  @@index([storeId, status, dueAt])
  @@index([consumerUserId, createdAt])
}

model PosSession {
  id            String    @id @default(cuid())
  merchantId    String
  storeId       String
  cashierName   String
  openingFloat  Int       @default(0)
  closingAmount Int?
  status        String    @default("OPEN")
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  @@index([storeId, status, openedAt])
}

model PosSale {
  id            String   @id @default(cuid())
  merchantId    String
  storeId       String
  sessionId     String
  paymentMethod String
  amount        Int
  currency      String   @default("BOB")
  items         Json
  customerName  String?
  customerEmail String?
  createdAt     DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([storeId, createdAt])
}

model IntegrationConnection {
  id         String    @id @default(cuid())
  merchantId String
  storeId    String
  kind       String
  name       String
  secretHash String
  status     String    @default("ACTIVE")
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([storeId, name])
  @@index([storeId, status, kind])
}

model IntegrationProductMapping {
  id            String   @id @default(cuid())
  connectionId  String
  paymentLinkId String
  externalSku   String
  externalName  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([connectionId, externalSku])
  @@unique([connectionId, paymentLinkId])
  @@index([paymentLinkId])
}

model IntegrationSubscriptionPlanMapping {
  id                 String   @id @default(cuid())
  connectionId       String
  subscriptionPlanId String
  externalPlanCode   String
  externalName       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([connectionId, externalPlanCode])
  @@unique([connectionId, subscriptionPlanId])
  @@index([subscriptionPlanId])
}

model IntegrationCustomerMapping {
  id                 String   @id @default(cuid())
  connectionId       String
  businessCustomerId String
  externalCustomerId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([connectionId, externalCustomerId])
  @@index([businessCustomerId])
}

model IntegrationSubscriptionMapping {
  id                     String   @id @default(cuid())
  connectionId           String
  customerSubscriptionId String   @unique
  externalSubscriptionId String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([connectionId, externalSubscriptionId])
  @@index([connectionId])
}

model IntegrationSyncRun {
  id           String    @id @default(cuid())
  connectionId String
  direction    String
  status       String    @default("RUNNING")
  itemCount    Int       @default(0)
  errorMessage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([connectionId, startedAt])
}

model AppointmentServiceOffering {
  id              String   @id @default(cuid())
  merchantId      String
  storeId         String
  name            String
  durationMinutes Int
  bufferMinutes   Int      @default(0)
  price           Int      @default(0)
  currency        String   @default("BOB")
  color           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId, isActive])
}

model Appointment {
  id                     String    @id @default(cuid())
  merchantId             String
  storeId                String
  serviceOfferingId      String
  customerName           String
  customerEmail          String?
  customerPhone          String?
  startsAt               DateTime
  endsAt                 DateTime
  status                 String    @default("CONFIRMED")
  holdExpiresAt          DateTime?
  notes                  String?
  depositPaymentIntentId String?
  googleEventId          String?   @unique
  calendarSyncError      String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([storeId, startsAt])
  @@index([storeId, status, holdExpiresAt])
  @@index([serviceOfferingId, startsAt])
}

model CalendarConnection {
  id                     String   @id @default(cuid())
  merchantId             String
  storeId                String   @unique
  provider               String   @default("GOOGLE")
  accountEmail           String?
  calendarId             String
  refreshTokenCiphertext String
  syncToken              String?
  status                 String   @default("ACTIVE")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([merchantId, status])
}

model CalendarOauthState {
  id         String   @id @default(cuid())
  stateHash  String   @unique
  merchantId String
  storeId    String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

model SubscriptionPlan {
  id                  String   @id @default(cuid())
  merchantId          String
  storeId             String
  name                String
  amount              Int
  currency            String   @default("BOB")
  interval            String   @default("MONTHLY")
  intervalCount       Int      @default(1)
  reminderHoursBefore Int      @default(24)
  collectionMode      String   @default("MANUAL_LINK")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId, isActive])
}

model CustomerSubscription {
  id                 String    @id @default(cuid())
  merchantId         String
  storeId            String
  planId             String
  customerId         String?
  customerName       String
  customerEmail      String?
  customerPhone      String?
  amountOverride     Int?
  nextAmountOverride Int?
  activeKey          String?   @unique
  status             String    @default("ACTIVE")
  startedAt          DateTime  @default(now())
  nextBillingAt      DateTime
  canceledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([storeId, status, nextBillingAt])
  @@index([planId, status])
}

model SubscriptionInvoice {
  id              String    @id @default(cuid())
  subscriptionId  String
  merchantId      String
  storeId         String
  periodStart     DateTime
  amount          Int
  currency        String    @default("BOB")
  status          String    @default("DUE")
  paymentIntentId String?
  dueAt           DateTime
  paidAt          DateTime?
  initialNoticeAt DateTime?
  lastReminderAt  DateTime?
  reminderCount   Int       @default(0)
  createdAt       DateTime  @default(now())

  @@unique([subscriptionId, periodStart])
  @@index([storeId, status, dueAt])
}
