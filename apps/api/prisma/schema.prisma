}

model EventPromoterAllocation {
  id             String                 @id @default(cuid())
  eventId        String
  event          Event                  @relation(fields: [eventId], references: [id])
  promoterId     String
  promoter       PromoterProfile        @relation(fields: [promoterId], references: [id])
  ticketTypeId   String?
  ticketType     TicketType?            @relation(fields: [ticketTypeId], references: [id])
  kind           PromoterAllocationKind
  quota          Int
  used           Int                    @default(0)
  discountAmount Int?
  createdAt      DateTime               @default(now())
