generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SettlementMode {
  AGGREGATOR
  FACILITATOR
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ApiKeyMode {
  TEST
  LIVE
}

enum ApiKeyType {
  PUBLISHABLE
  SECRET
}

enum PaymentMethodType {
  CARD
  TIGO_MONEY
  BANK_TRANSFER
  QR
}

enum PaymentIntentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  PROCESSING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
}

enum TransactionType {
  AUTHORIZATION
  CAPTURE
  REFUND
  PAYOUT
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum LedgerAccount {
  RAIL_CLEARING
  MERCHANT_PAYABLE
  PAGOSYA_FEE_REVENUE
  RESERVE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum WebhookEventStatus {
  PENDING
  DELIVERED
  FAILED
}

enum KycStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  PENDING
  EMITTED
  FAILED
}

enum PayoutStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// A named pagosYa staff member allowed to review KYC — replaces a single
// shared INTERNAL_OPS_SECRET so every review decision is attributable to a
// specific, revocable person instead of "whoever had the secret."
model OpsUser {
  id          String                  @id @default(cuid())
  name        String
  email       String                  @unique
  hashedToken String
  revokedAt   DateTime?
  createdAt   DateTime                @default(now())
  kycReviews  MerchantKycSubmission[]
}

// Generic append-only trail for sensitive ops actions (KYC review today;
// intentionally generic so other ops actions can log to it later without a
// schema change).
model AuditLogEntry {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String
  actorLabel String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model Merchant {
  id               String                    @id @default(cuid())
  name             String
  email            String                    @unique
  settlementMode   SettlementMode            @default(AGGREGATOR)
  status           MerchantStatus            @default(PENDING)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  apiKeys          ApiKey[]
  paymentIntents   PaymentIntent[]
  webhookEndpoints WebhookEndpoint[]
  kycSubmissions   MerchantKycSubmission[]
  invoicingProfile MerchantInvoicingProfile?
  invoices         Invoice[]
  payouts          Payout[]
  users            MerchantUser[]
  stores           Store[]
  mediaAssets      MediaAsset[]
  productStats     StoreProductStat[]
}

// A human login for the merchant dashboard — deliberately separate from
// ApiKey. The dashboard must never need a merchant's secret key in the
// browser; this is what apps/merchant-dashboard authenticates with instead.
model MerchantUser {
  id                  String                   @id @default(cuid())
  merchantId          String
  merchant            Merchant                 @relation(fields: [merchantId], references: [id])
  email               String                   @unique
  hashedPassword      String
  // Null until the confirmation link is used. An unverified row doesn't
  // permanently claim its email — see MerchantUserService.signup for why.
  emailVerifiedAt     DateTime?
  createdAt           DateTime                 @default(now())
  sessions            MerchantSession[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

// Single-use, short-lived proof that whoever called signup actually
// controls the email they claimed — closes the account-squatting/
// enumeration gap a bare email-uniqueness check would otherwise open.
model EmailVerificationToken {
  id             String       @id @default(cuid())
  merchantUserId String
  merchantUser   MerchantUser @relation(fields: [merchantUserId], references: [id])
  hashedToken    String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
  @@index([hashedToken])
}

// Single-use, short-lived (1h) password reset token. requestPasswordReset()
// always responds identically regardless of whether the email exists — same
// enumeration-safety reasoning as MerchantUserService.signup.
model PasswordResetToken {
  id             String       @id @default(cuid())
  merchantUserId String
  merchantUser   MerchantUser @relation(fields: [merchantUserId], references: [id])
  hashedToken    String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
}

// Short-lived, revocable dashboard session token (dash_...) — what
// MerchantAuthGuard accepts alongside a secret API key.
model MerchantSession {
  id             String       @id @default(cuid())
  merchantUserId String
  merchantUser   MerchantUser @relation(fields: [merchantUserId], references: [id])
  merchantId     String
  hashedToken    String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
}

// NIT/branch/point-of-sale registration a merchant needs on file before
// pagosYa can emit a Factura Electrónica on their behalf. `cuis` is issued
// once per (nit, sucursal, puntoVenta); `cufd`/`cufdExpiresAt` cache SIN's
// daily invoicing code (valid ~24h — see InvoicingService/InvoiceEmissionWorker).
model MerchantInvoicingProfile {
  id            String    @id @default(cuid())
  merchantId    String    @unique
  merchant      Merchant  @relation(fields: [merchantId], references: [id])
  nit           String
  razonSocial   String
  sucursal      Int       @default(0)
  puntoVenta    Int       @default(0)
  cuis          String?
  cuisIssuedAt  DateTime?
  cufd          String?
  cufdExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// One Factura Electrónica per succeeded PaymentIntent. Created PENDING in the
// same transaction as the payment's success (transactional outbox, same
// pattern as WebhookEvent) and emitted asynchronously by InvoiceEmissionWorker
// — SIN's real service is external, can be slow/down, and needs retries.
model Invoice {
  id               String        @id @default(cuid())
  merchantId       String
  merchant         Merchant      @relation(fields: [merchantId], references: [id])
  paymentIntentId  String        @unique
  paymentIntent    PaymentIntent @relation(fields: [paymentIntentId], references: [id])
  amount           Int
  currency         String        @default("BOB")
  customerName     String        @default("SIN NOMBRE")
  customerDocument String        @default("0")
  status           InvoiceStatus @default(PENDING)
  cuf              String?
  cufd             String?
  attempts         Int           @default(0)
  nextRetryAt      DateTime?
  failureReason    String?
  emittedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([status, nextRetryAt])
}

// Payout is the payout-side analog of Transaction (which is always scoped to
// one PaymentIntent): a payout nets a merchant's *unpaid* MERCHANT_PAYABLE
// ledger balance across many PaymentIntents into one disbursement. Only ever
// created for AGGREGATOR merchants — FACILITATOR merchants' MERCHANT_PAYABLE
// entries are informational only, since the rail already settled funds
// straight to them; paying those out too would be sending money twice.
model Payout {
  id            String       @id @default(cuid())
  merchantId    String
  merchant      Merchant     @relation(fields: [merchantId], references: [id])
  amount        Int
  currency      String       @default("BOB")
  bankAccount   String
  status        PayoutStatus @default(PENDING)
  railReference String?
  failureReason String?
  attempts      Int          @default(0)
  nextRetryAt   DateTime?
  paidOutAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, nextRetryAt])
  @@index([merchantId, createdAt])
}

model MerchantKycSubmission {
  id                  String    @id @default(cuid())
  merchantId          String
  merchant            Merchant  @relation(fields: [merchantId], references: [id])
  legalName           String
  taxId               String
  legalRepName        String
  legalRepDocumentId  String
  payoutBankAccount   String
  status              KycStatus @default(PENDING_REVIEW)
  reviewNote          String?
  reviewedAt          DateTime?
  reviewedByOpsUserId String?
  reviewedByOpsUser   OpsUser?  @relation(fields: [reviewedByOpsUserId], references: [id])
  // Snapshot of the reviewer's name/email at review time — the audit record
  // shouldn't change retroactively if the OpsUser is later renamed/revoked.
  reviewedByLabel     String?
  createdAt           DateTime  @default(now())

  @@index([merchantId, createdAt])
}

model ApiKey {
  id           String     @id @default(cuid())
  merchantId   String
  merchant     Merchant   @relation(fields: [merchantId], references: [id])
  mode         ApiKeyMode
  type         ApiKeyType
  keyPrefix    String
  hashedSecret String
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([keyPrefix])
}

model PaymentIntent {
  id                   String              @id @default(cuid())
  merchantId           String
  merchant             Merchant            @relation(fields: [merchantId], references: [id])
  amount               Int
  currency             String              @default("BOB")
  status               PaymentIntentStatus @default(REQUIRES_PAYMENT_METHOD)
  paymentMethodType    PaymentMethodType?
  paymentMethodId      String?
  paymentMethod        PaymentMethod?      @relation(fields: [paymentMethodId], references: [id])
  clientSecret         String              @unique
  livemode             Boolean             @default(false)
  description          String?
  metadata             Json?
  railId               String?
  confirmationAttempts Int                 @default(0)
  lastError            Json?
  customerName         String?
  customerDocument     String?
  // Buyer contact info, collected at checkout so the merchant can reach out
  // about this order — separate from customerDocument (tax ID, for invoicing).
  customerEmail        String?
  customerPhone        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  transactions         Transaction[]
  invoice              Invoice?

  @@index([merchantId, createdAt])
}

enum PaymentLinkStatus {
  ACTIVE
  ARCHIVED
}

// No-code entry point: a merchant with no developer creates one of these from
// the dashboard and gets a shareable storefront URL/QR. A merchant can run
// several independent Stores (e.g. two different shops under one account) —
// each has its own slug/branding/product catalog. The public checkout page
// (apps/checkout, ?link=<slug>) turns a visit into a PaymentIntent via
// StoresService — same PaymentIntent/rail/ledger machinery as the full API
// path, just without requiring a merchant backend to call anything.
model Store {
  id                 String                @id @default(cuid())
  merchantId         String
  merchant           Merchant              @relation(fields: [merchantId], references: [id])
  slug               String                @unique
  name               String
  // Short about/tagline text shown under the store name on the storefront.
  tagline            String?
  // "/v1/uploads/<uuid>.<ext>" — path returned by POST /v1/uploads, not a data URL.
  logoUrl            String?
  // Wide header image, separate from logoUrl (which stays small/square).
  bannerUrl          String?
  // "#RRGGBB", validated at the DTO layer only.
  backgroundColor    String?
  // "/v1/uploads/<uuid>.<ext>" — full-page storefront background photo.
  // Independent of backgroundColor: when set, the image is what's shown
  // (backgroundColor still renders behind it while the image loads / behind
  // any transparent areas), when unset backgroundColor (or the default) is
  // used as before.
  backgroundImageUrl String?
  // Support channel shown to customers on the receipt/success screen — e.g.
  // for a refund request or an order question. Both optional and independent
  // (a merchant may only want to expose one).
  contactPhone       String?
  contactEmail       String?
  // Long-form brand story ("Nuestra historia") rendered as its own storefront
  // section — multi-paragraph (blank-line separated), unlike the one-line tagline.
  aboutText          String?
  aboutTitle         String?
  aboutSubtitle      String?
  // Optional background photo for the "Nuestra historia" section. The section
  // remains plain and transparent when this is null.
  aboutImageUrl      String?
  catalogTitle       String?
  catalogSubtitle    String?
  galleryTitle       String?
  gallerySubtitle    String?
  // "#RRGGBB" brand accent for storefront highlights (chips, links, pay button,
  // title gradient). Null = pagosYa's default palette accent, per theme.
  accentColor        String?
  // Curated storefront typography: "mono" (default) | "modern" |
  // "editorial" | "friendly". The dashboard itself always keeps pagosYa's
  // 0xProto Mono identity; this choice belongs only to the merchant storefront.
  fontStyle          String                @default("mono")
  // Corner treatment for the storefront's interactive elements:
  // "rounded" (default) | "pill" | "square". Validated at the DTO layer.
  buttonStyle        String                @default("rounded")
  // Storefront ground material for the "El Tablero" (hand-lettered price
  // board) visual world: "chalkboard" (default) | "kraft" | "painted".
  // Validated at the DTO layer.
  boardTexture       String                @default("chalkboard")
  // Short promo/notice line shown in a bar at the very top of the storefront.
  announcement       String?
  // "static" (default) | "marquee". Speed is one full marquee pass in seconds.
  announcementMode   String                @default("static")
  announcementSpeed  Int                   @default(18)
  // Merchant-controlled announcement presentation. Color is the strip
  // background; storefront code derives a contrasting ink color automatically.
  announcementSize   String                @default("medium")
  announcementColor  String                @default("#c58b3c")
  // Merchant-authored promotion dialog. The customer can dismiss it for the
  // current browser session; preview mode always renders it for editing.
  promotionEnabled   Boolean               @default(false)
  promotionTitle     String?
  promotionBody      String?
  promotionCtaLabel  String?
  promotionCtaUrl    String?
  // Ordered, merchant-authored storefront hero slides. JSON keeps this
  // lightweight customization atomic with the rest of the appearance editor;
  // every entry is validated by CreateStoreDto before it reaches Prisma.
  heroSlides         Json                  @default("[]")
  // Every public content section appears exactly once. The dashboard edits
  // this array as an ordered list; empty sections simply do not render.
  contentOrder       Json                  @default("[\"hero\",\"about\",\"products\",\"gallery\",\"links\"]")
  // Captioned brand/editorial photos, separate from product image galleries.
  // Validated JSON snapshot [{ imageUrl, caption }], maximum 8 entries.
  editorialGallery   Json                  @default("[]")
  // Button customization layers: corner shape lives in buttonStyle; these
  // control fill treatment, motion, and the customer-facing cart CTA copy.
  buttonVariant      String                @default("solid")
  buttonMotion       String                @default("lift")
  cartButtonLabel    String                @default("Ir a pagar")
  status             StoreStatus           @default(ACTIVE)
  // Incremented once per storefront page load (getStorePublic) — a simple
  // visit counter, not deduplicated per visitor. Good enough for "is anyone
  // looking at this store" without building real analytics infra.
  viewCount          Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  paymentLinks       PaymentLink[]
  categories         Category[]
  links              StoreLink[]
  mediaAssets        MediaAsset[]
  visualProposals    StoreVisualProposal[]
  visualVersions     StoreVisualVersion[]

  @@index([merchantId, createdAt])
}

enum MediaAssetKind {
  ORIGINAL
  AI_DERIVED
}

// Upload ownership and lineage live in the database even when the bytes move
// from local disk to object storage. Original merchant files are never
// overwritten by AI output; derived files point back to their source.
model MediaAsset {
  id            String         @id @default(cuid())
  merchantId    String
  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  storeId       String?
  store         Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  url           String         @unique
  storageKey    String         @unique
  kind          MediaAssetKind @default(ORIGINAL)
  mimeType      String
  byteSize      Int
  parentAssetId String?
  parentAsset   MediaAsset?    @relation("MediaAssetLineage", fields: [parentAssetId], references: [id], onDelete: SetNull)
  derivatives   MediaAsset[]   @relation("MediaAssetLineage")
  createdAt     DateTime       @default(now())

  @@index([merchantId, createdAt])
  @@index([storeId, createdAt])
}

enum VisualProposalStatus {
  READY
  APPLIED
  DISMISSED
}

// A proposal stores only the bounded storefront configuration accepted by the
// API. It never stores or executes model-generated HTML, CSS, or JavaScript.
model StoreVisualProposal {
  id              String               @id @default(cuid())
  storeId         String
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title           String
  rationale       String
  provider        String
  status          VisualProposalStatus @default(READY)
  config          Json
  sourceAssetUrls Json                 @default("[]")
  generatedUrls   Json                 @default("[]")
  appliedAt       DateTime?
  createdAt       DateTime             @default(now())

  @@index([storeId, createdAt])
}

// Snapshots are created before applying an AI proposal or restoring an older
// version, making every visual change reversible without touching products.
model StoreVisualVersion {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label     String
  source    String
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

// Merchant-defined buttons rendered under the storefront header — social
// profiles, a catalog PDF, a map pin, anything the merchant wants to link out
// to. Replaced wholesale via PUT /v1/stores/:id/links (order = sortOrder), so
// there's no per-row CRUD.
model StoreLink {
  id        String @id @default(cuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label     String
  // http(s) only, enforced at the DTO layer — these render as clickable
  // buttons on a customer-facing page, so no javascript:/data: schemes.
  url       String
  sortOrder Int    @default(0)

  @@index([storeId, sortOrder])
}

enum StoreStatus {
  ACTIVE
  ARCHIVED
}

// Groups a Store's products into sections on the storefront (e.g. "Bebidas",
// "Postres") — optional per product; uncategorized products still render,
// just outside any section.
model Category {
  id           String        @id @default(cuid())
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  paymentLinks PaymentLink[]

  @@index([storeId, sortOrder])
}

// A product within a Store's catalog.
model PaymentLink {
  id          String            @id @default(cuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String?
  // "/v1/uploads/<uuid>.<ext>" paths returned by POST /v1/uploads — first
  // entry is the cover photo, rest render as a gallery. Replaces the old
  // single `imageUrl` column (see migration 20260807150000_store_catalog_v2).
  imageUrls   String[]          @default([])
  // Free-form small labels the merchant types, e.g. "Nuevo", "Agotado" —
  // rendered as pill badges on the storefront. Not a controlled vocabulary.
  tags        String[]          @default([])
  // Remaining units, null = not tracked (unlimited, today's behavior for
  // every existing product). When set, the storefront caps cart quantity to
  // it and cart-checkout/payment success enforce it server-side.
  stock       Int?
  // "#RRGGBB" product color swatch (e.g. a T-shirt color), validated at the DTO layer only.
  color       String?
  // Optional purchasable choices such as Pequeña/Grande. Stored as a small
  // validated JSON snapshot [{ id, name, amount, stock }]. A missing stock
  // field preserves the earlier shared-product-stock behavior; null means the
  // option is unlimited, and an integer is decremented atomically in Postgres.
  variants    Json              @default("[]")
  amount      Int
  currency    String            @default("BOB")
  status      PaymentLinkStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([storeId, createdAt])
  @@index([categoryId])
}

// Persisted checkout totals keep storefront sorting and finance summaries
// bounded as payment history grows. storeId/paymentLinkId are snapshots, not
// foreign keys, so deleting a storefront never erases its financial history.
model StoreProductStat {
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  storeId       String
  paymentLinkId String
  productName   String
  quantity      Int      @default(0)
  revenue       Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@id([storeId, paymentLinkId])
  @@index([merchantId, quantity])
  @@index([storeId, quantity])
}

model PaymentMethod {
  id             String            @id @default(cuid())
  merchantId     String
  type           PaymentMethodType
  token          String
  last4          String?
  brand          String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  paymentIntents PaymentIntent[]

  @@unique([merchantId, token])
}

model Transaction {
  id              String            @id @default(cuid())
  paymentIntentId String
  paymentIntent   PaymentIntent     @relation(fields: [paymentIntentId], references: [id])
  type            TransactionType
  railId          String
  amount          Int
  status          TransactionStatus
  railReference   String?
  rawResponse     Json?
  createdAt       DateTime          @default(now())
  ledgerEntries   LedgerEntry[]

  @@index([paymentIntentId])
}

model LedgerEntry {
  id                 String          @id @default(cuid())
  transactionGroupId String
  transactionId      String?
  transaction        Transaction?    @relation(fields: [transactionId], references: [id])
  merchantId         String?
  account            LedgerAccount
  direction          LedgerDirection
  amount             Int
  currency           String          @default("BOB")
  createdAt          DateTime        @default(now())

  @@index([transactionGroupId])
  @@index([merchantId, account])
}

model WebhookEndpoint {
  id            String         @id @default(cuid())
  merchantId    String
  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  url           String
  secret        String
  enabledEvents String[]
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  events        WebhookEvent[]
}

model WebhookEvent {
  id                 String             @id @default(cuid())
  merchantId         String
  webhookEndpointId  String
  webhookEndpoint    WebhookEndpoint    @relation(fields: [webhookEndpointId], references: [id])
  eventType          String
  payload            Json
  status             WebhookEventStatus @default(PENDING)
  attempts           Int                @default(0)
  nextRetryAt        DateTime?
  lastAttemptAt      DateTime?
  lastResponseStatus Int?
  createdAt          DateTime           @default(now())

  @@index([status, nextRetryAt])
}

model IdempotencyKey {
  id             String    @id @default(cuid())
  merchantId     String
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  status         String    @default("IN_PROGRESS")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@unique([merchantId, key])
}
