{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": false,
    "assets": [
      {
        "include": "rails/adapters/dlocal/fixtures/*.json",
        "watchAssets": true,
        "outDir": "dist/src"
      }
    ]
  }
}
