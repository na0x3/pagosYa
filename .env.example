# apps/api
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/pagosya?schema=public"
# Per API process. Keep the total across replicas below PostgreSQL's connection
# budget, or point DATABASE_URL at PgBouncer and size this for the proxy.
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10
# Required in production so rate limits are shared by every API replica.
# REDIS_URL="rediss://default:password@redis.example:6379/0"
PORT=3000
NODE_ENV=development
# Set this to the number of trusted reverse-proxy hops in production (commonly 1).
# Never enable it unless requests really arrive through that controlled proxy;
# correct client IPs are required for rate limiting.
TRUST_PROXY=false
# API docs default to off in production. Enable only behind appropriate access controls.
EXPOSE_API_DOCS=false
INTERNAL_RAIL_CALLBACK_SECRET="dev-internal-secret-change-me"
# Only gates POST /internal/ops_users (creating/revoking named reviewers) —
# day-to-day KYC review uses each reviewer's own ops_... token instead.
INTERNAL_OPS_SECRET="dev-internal-ops-secret-change-me"
CHECKOUT_ORIGIN="http://localhost:5174"
CONSUMER_DASHBOARD_ORIGIN="http://localhost:4324"
MERCHANT_DASHBOARD_ORIGIN="http://localhost:4322"
ORDER_TRACKING_SECRET="development-only-order-tracking-secret-change-me"
DOCUMENT_LINK_SECRET="development-only-document-link-secret-change-me"
# Per-store cap on cobro / proposal / contract emails in any 24 hours (1–100000).
DOCUMENT_EMAILS_PER_DAY=200
# HMAC key for storefront analytics session hashes (its own secret: analytics rows never join funnel visits or orders).
ANALYTICS_SESSION_SECRET="development-only-analytics-session-secret-change-me"
# Per-store ceiling on storefront analytics events stored per Bolivia day (1–10000000).
STORE_ANALYTICS_DAILY_CAP=50000
OPERATIONS_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
# HMAC key for event claim, management, and short enrollment-code digests.
# Required in production; generate at least 32 random characters.
EVENT_TOKEN_SECRET="replace-with-at-least-32-random-characters"

# Access-control adapter. `mock` is complete and is the only supported mode
# until official SpeedFace-V5 protocol documentation is supplied.
ZKTECO_INTEGRATION_MODE="mock"
ZKTECO_DEVICE_HOST=""
ZKTECO_DEVICE_PORT=""
ZKTECO_USERNAME=""
ZKTECO_PASSWORD=""
# Raw vendor payloads are not persisted by default.
DEVICE_RAW_EVENT_RETENTION_HOURS=0
# DNS target shown to merchants connecting a custom storefront domain. The
# production edge for this hostname must accept arbitrary verified hostnames
# and issue their TLS certificates (for example via Cloudflare for SaaS).
CUSTOM_DOMAIN_CNAME_TARGET="stores.pagosya.bo"
# Local fallback for uploads. The default is always apps/api/uploads/, even if
# the API process is launched from the repository root.
# UPLOADS_DIR="/absolute/path/to/uploads"
# Production: set these values to use durable S3-compatible object storage
# (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, etc.). Stored URLs remain
# /v1/uploads/<uuid>.<ext>, so storefront data stays vendor-independent.
# OBJECT_STORAGE_BUCKET="pagosya-media"
# OBJECT_STORAGE_REGION="us-east-1"
# OBJECT_STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# OBJECT_STORAGE_ACCESS_KEY_ID=""
# OBJECT_STORAGE_SECRET_ACCESS_KEY=""
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Digital downloads require a separate bucket with public access disabled.
# Required when uploading digital goods in production; uses the same S3 credentials.
# PRIVATE_DOWNLOAD_BUCKET="pagosya-private-downloads"

# Optional AI visual proposals. Originals are preserved and generated assets
# remain drafts until the merchant explicitly applies one.
# OPENAI_API_KEY=""
# Optional alternative for YAPI chat and site generation. Keep keys on the server.
# DEEPSEEK_API_KEY=""
DEEPSEEK_ENABLED=true
# Claude models for YAPI (Opus 5.5, Sonnet 5, Haiku 4.5). They run on the tool-using agent; without it, choosing one shows a clear setup error.
# ANTHROPIC_API_KEY=""
OPENAI_VISUAL_STUDIO_ENABLED=true
OPENAI_CONVERSATION_MODEL="gpt-5.6-terra"
OPENAI_DESIGN_MODEL="gpt-5.6-sol"
OPENAI_INVENTORY_MODEL="gpt-5.6-sol"
OPENAI_IMAGE_MODEL="gpt-image-2"
# apps/ops and apps/merchant-dashboard call the API directly from the browser
ADDITIONAL_CORS_ORIGINS="http://localhost:4322,http://localhost:4323,http://localhost:5175"

# Google Identity Services web client. Configure authorized JavaScript origins
# for the consumer and merchant dashboards in Google Cloud Console.
# GOOGLE_CLIENT_ID="000000000000-example.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
# GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/v1/calendar/google/callback"

# Transactional email (dashboard signup verification, password reset) — see
# DashboardModule/ResendEmailProvider. Unset (default) keeps MockEmailProvider,
# which just logs the email/link to the console instead of sending — fine for
# local dev. Set RESEND_API_KEY to send for real (get one at resend.com).
# NOTE: without a verified sending domain, Resend sandbox mode only delivers
# to the account's own verified address — real merchant signups need a
# verified domain (e.g. pagosya.bo) at resend.com/domains first.
# RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="PagosYa <onboarding@resend.dev>"
# Verifies Resend's inbound webhook on POST /v1/email/inbound (the merchant inbox).
# Required whenever inbound email is enabled; an empty value rejects every delivery.
RESEND_INBOUND_SIGNING_SECRET=""

# Where verification/reset links in emails point — the marketing site
# (pagosYaWeb), not this API and not the checkout iframe.
PAGOSYA_WEB_ORIGIN="http://localhost:3001"

# dLocal cross-border card acquiring (international checkout). DLOCAL_ENABLED=false
# (the default) keeps fixture mode, which fakes payments — see dlocalChargesAllowed()
# in config/configuration.ts: international charges are only offered in production
# when the real client is switched on. Never commit the trans/secret keys.
DLOCAL_ENABLED=false
DLOCAL_BASE_URL="https://sandbox.dlocal.com"
DLOCAL_LOGIN=""
DLOCAL_TRANS_KEY=""
DLOCAL_SECRET_KEY=""
DLOCAL_SMART_FIELDS_KEY=""
# Where dLocal posts payment notifications; must be publicly reachable in production.
# POST /v1/webhooks/dlocal/payments verifies the raw body, so keep the path.
DLOCAL_NOTIFICATION_URL="http://localhost:3000/v1/webhooks/dlocal/payments"
# Where the shopper is returned after paying — the checkout origin, not the API.
DLOCAL_RETURN_URL="http://localhost:5173/"
# Request timeout against dLocal, milliseconds.
DLOCAL_TIMEOUT_MS=15000
# What dLocal charges the platform, basis points. Reporting only; 0 = not modelled.
DLOCAL_COST_BPS=0

# International pricing. No exchange rate is assumed: leave INTL_BOB_PER_USD at 0
# and international charges stay unpriced rather than silently using a wrong rate.
INTL_BOB_PER_USD=0
# Platform fee added to international charges, basis points (590 = 5.90%).
INTL_FEE_BPS=590

# Banco Económico QR Simple (apps/api/src/rails/adapters/baneco) — sandbox credentials.
# BANECO_QR_ENABLED=false (default) keeps PaymentMethodType.QR on MockQrRailAdapter;
# set true to route real QR generation through Baneco instead. First bank integration,
# expected to be replaced — see RailsModule for how the swap works.
BANECO_QR_ENABLED=false
BANECO_BASE_URL="https://apimktdesa.baneco.com.bo/ApiGateway"
BANECO_USERNAME=""
BANECO_PASSWORD=""
BANECO_AES_KEY=""
BANECO_CREDIT_ACCOUNT=""
# Header secret Baneco's notifyPaymentQR webhook must present as
# X-Baneco-Webhook-Secret on POST /v1/webhooks/baneco/qr.
BANECO_WEBHOOK_SECRET="dev-baneco-webhook-secret-change-me"

# SIN/SIAT SFVL pilot. Keep SIAT_ENABLED=false until a delegated token and
# system code have been configured. Never commit the delegated token.
SIAT_ENABLED=false
SIAT_BASE_URL="https://pilotosiatservicios.impuestos.gob.bo/v2"
SIAT_DELEGATED_TOKEN=""
SIAT_SYSTEM_CODE=""
SIAT_ENVIRONMENT_CODE=2
SIAT_MODALITY_CODE=2

# apps/checkout
VITE_API_BASE_URL="http://localhost:3001/v1"
VITE_CONSUMER_DASHBOARD_ORIGIN="http://localhost:4324"
# Standalone Merchant Studio: destination for the first-sale product setup action.
VITE_DASHBOARD_ORIGIN="http://localhost:4323"
# Origin the checkout iframe is served from. Studio uses it to build checkout
# links; checkout itself falls back to location.origin when unset.
VITE_CHECKOUT_ORIGIN="http://localhost:5174"
# Dev-only: lets the checkout page's "simulate confirmation" button drive the
# requires_action -> succeeded/failed path without real bank/Tigo Money infra.
# Must match INTERNAL_RAIL_CALLBACK_SECRET above. Never set in production.
VITE_DEV_INTERNAL_RAIL_CALLBACK_SECRET="dev-internal-secret-change-me"

# Public URL embedded in independent storefront exports (HTTPS in production).
PUBLIC_API_URL="http://localhost:3001/v1"

# New storefronts and full redesigns use Next.js/React/Tailwind. Legacy local edits keep their format.
SOURCE_FRAMEWORK=next
# Opt-in durable visual review/repair. Apply the design-job migrations first.
SOURCE_DESIGN_JOBS_ENABLED=false
# Set to "false" to disable rendered reference capture (headless Chromium visits a
# merchant-supplied URL in an ephemeral, credential-free profile). Turn it off where
# the API host has no browser or must not make outbound requests.
SOURCE_REFERENCE_CAPTURE=true

# Domain shop: Name.com Core API + Cloudflare for SaaS. Disabled until configured.
DOMAIN_COMMERCE_ENABLED="false"
DOMAIN_REGISTRAR_SANDBOX="true"
NAMECOM_USERNAME=""
NAMECOM_API_TOKEN=""
# The platform's ACTIVE merchant account receives domain payments (not the buying store).
DOMAIN_PLATFORM_MERCHANT_ID=""
# Explicit operator pricing policy; no assumed exchange rate. Amounts shown in BOB.
DOMAIN_BOB_PER_USD="0"
DOMAIN_MARKUP_PERCENT="0"
DOMAIN_CLOUDFLARE_API_TOKEN=""
DOMAIN_CLOUDFLARE_ZONE_ID=""

# ── Integration tests ───────────────────────────────────────────────────────
# Postgres *server* the integration suites connect to as an admin. They never
# touch your application database: each CREATEs a throwaway database, applies
# every migration to it, and DROPs it afterwards. Unset, they fall back to
# DATABASE_URL's server with the "postgres" maintenance database, and skip
# visibly (never silently pass) when no server answers.
# INBOX_IT_ADMIN_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# apps/merchant-dashboard
# Set to "1" to serve the dashboard with live reload during local development.
DASHBOARD_LIVE_RELOAD=0

# apps/demo — the sample integration server, not part of the platform.
# A sk_test_... key from `pnpm --filter @pagosya/api run seed`.
# PAGOSYA_SECRET_KEY=""
