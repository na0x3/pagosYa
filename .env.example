# apps/api
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/pagosya?schema=public"
# Per API process. Keep the total across replicas below PostgreSQL's connection
# budget, or point DATABASE_URL at PgBouncer and size this for the proxy.
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10
# Required in production so rate limits are shared by every API replica.
# REDIS_URL="rediss://default:password@redis.example:6379/0"
PORT=3000
NODE_ENV=development
# Set this to the number of trusted reverse-proxy hops in production (commonly 1).
# Never enable it unless requests really arrive through that controlled proxy;
# correct client IPs are required for rate limiting.
TRUST_PROXY=false
# API docs default to off in production. Enable only behind appropriate access controls.
EXPOSE_API_DOCS=false
INTERNAL_RAIL_CALLBACK_SECRET="dev-internal-secret-change-me"
# Only gates POST /internal/ops_users (creating/revoking named reviewers) —
# day-to-day KYC review uses each reviewer's own ops_... token instead.
INTERNAL_OPS_SECRET="dev-internal-ops-secret-change-me"
CHECKOUT_ORIGIN="http://localhost:5174"
CONSUMER_DASHBOARD_ORIGIN="http://localhost:4324"
MERCHANT_DASHBOARD_ORIGIN="http://localhost:4322"
ORDER_TRACKING_SECRET="development-only-order-tracking-secret-change-me"
OPERATIONS_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
# DNS target shown to merchants connecting a custom storefront domain. The
# production edge for this hostname must accept arbitrary verified hostnames
# and issue their TLS certificates (for example via Cloudflare for SaaS).
CUSTOM_DOMAIN_CNAME_TARGET="stores.pagosya.bo"
# Local fallback for uploads. The default is always apps/api/uploads/, even if
# the API process is launched from the repository root.
# UPLOADS_DIR="/absolute/path/to/uploads"
# Production: set these values to use durable S3-compatible object storage
# (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, etc.). Stored URLs remain
# /v1/uploads/<uuid>.<ext>, so storefront data stays vendor-independent.
# OBJECT_STORAGE_BUCKET="pagosya-media"
# OBJECT_STORAGE_REGION="us-east-1"
# OBJECT_STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# OBJECT_STORAGE_ACCESS_KEY_ID=""
# OBJECT_STORAGE_SECRET_ACCESS_KEY=""
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Optional AI visual proposals. Originals are preserved and generated assets
# remain drafts until the merchant explicitly applies one.
# OPENAI_API_KEY=""
OPENAI_VISUAL_STUDIO_ENABLED=true
OPENAI_DESIGN_MODEL="gpt-5.6-sol"
OPENAI_INVENTORY_MODEL="gpt-5.6-sol"
OPENAI_IMAGE_MODEL="gpt-image-2"
# apps/ops and apps/merchant-dashboard call the API directly from the browser
ADDITIONAL_CORS_ORIGINS="http://localhost:4322,http://localhost:4323,http://localhost:5175"

# Google Identity Services web client. Configure authorized JavaScript origins
# for the consumer and merchant dashboards in Google Cloud Console.
# GOOGLE_CLIENT_ID="000000000000-example.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
# GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/v1/calendar/google/callback"

# Transactional email (dashboard signup verification, password reset) — see
# DashboardModule/ResendEmailProvider. Unset (default) keeps MockEmailProvider,
# which just logs the email/link to the console instead of sending — fine for
# local dev. Set RESEND_API_KEY to send for real (get one at resend.com).
# NOTE: without a verified sending domain, Resend sandbox mode only delivers
# to the account's own verified address — real merchant signups need a
# verified domain (e.g. pagosya.bo) at resend.com/domains first.
# RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="PagosYa <onboarding@resend.dev>"
# Where verification/reset links in emails point — the marketing site
# (pagosYaWeb), not this API and not the checkout iframe.
PAGOSYA_WEB_ORIGIN="http://localhost:3001"

# Banco Económico QR Simple (apps/api/src/rails/adapters/baneco) — sandbox credentials.
# BANECO_QR_ENABLED=false (default) keeps PaymentMethodType.QR on MockQrRailAdapter;
# set true to route real QR generation through Baneco instead. First bank integration,
# expected to be replaced — see RailsModule for how the swap works.
BANECO_QR_ENABLED=false
BANECO_BASE_URL="https://apimktdesa.baneco.com.bo/ApiGateway"
BANECO_USERNAME=""
BANECO_PASSWORD=""
BANECO_AES_KEY=""
BANECO_CREDIT_ACCOUNT=""
# Header secret Baneco's notifyPaymentQR webhook must present as
# X-Baneco-Webhook-Secret on POST /v1/webhooks/baneco/qr.
BANECO_WEBHOOK_SECRET="dev-baneco-webhook-secret-change-me"

# SIN/SIAT SFVL pilot. Keep SIAT_ENABLED=false until a delegated token and
# system code have been configured. Never commit the delegated token.
SIAT_ENABLED=false
SIAT_BASE_URL="https://pilotosiatservicios.impuestos.gob.bo/v2"
SIAT_DELEGATED_TOKEN=""
SIAT_SYSTEM_CODE=""
SIAT_ENVIRONMENT_CODE=2
SIAT_MODALITY_CODE=2

# apps/checkout
VITE_API_BASE_URL="http://localhost:3001/v1"
VITE_CONSUMER_DASHBOARD_ORIGIN="http://localhost:4324"
# Dev-only: lets the checkout page's "simulate confirmation" button drive the
# requires_action -> succeeded/failed path without real bank/Tigo Money infra.
# Must match INTERNAL_RAIL_CALLBACK_SECRET above. Never set in production.
VITE_DEV_INTERNAL_RAIL_CALLBACK_SECRET="dev-internal-secret-change-me"
