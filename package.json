{
  "name": "pagosya",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:chatgpt": "node scripts/chatgpt-plan.mjs dev",
    "chatgpt:login": "node scripts/chatgpt-plan.mjs login",
    "chatgpt:logout": "node scripts/chatgpt-plan.mjs logout",
    "chatgpt:status": "node scripts/chatgpt-plan.mjs status",
    "chatgpt:models": "node scripts/chatgpt-plan.mjs models",
    "chatgpt:smoke": "node scripts/chatgpt-plan.mjs smoke",
    "test:chatgpt": "node --test scripts/chatgpt-plan/*.test.mjs",
    "dev:db": "node scripts/dev-db.mjs start",
    "dev:db:stop": "node scripts/dev-db.mjs stop",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:dashboard": "pnpm --filter @pagosya/merchant-dashboard run dev",
    "dev:studio": "pnpm --filter @pagosya/merchant-studio run dev",
    "storefront:source": "node scripts/storefront-source.mjs",
    "dev:consumer": "pnpm --filter @pagosya/consumer-dashboard run dev",
    "demo:store": "node scripts/demo-store.mjs",
    "demo:inventory-db": "node examples/cafe-aroma/setup.mjs",
    "demo:inventory-stock": "node examples/cafe-aroma/update-stock.mjs",
    "demo:inventory-sync": "node examples/cafe-aroma/sync-stock.mjs",
    "demo:subscriptions-sync": "node examples/cafe-aroma/sync-subscriptions.mjs",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:source-requests": "pnpm --filter @pagosya/api exec node -r ts-node/register scripts/source-request-gauntlet.ts",
    "dev:independent-cafe": "node examples/independent-cafe/build.mjs && node examples/independent-cafe/server.mjs",
    "benchmark:source": "pnpm --filter @pagosya/api exec node --env-file=.env -r ts-node/register scripts/benchmark-source.ts",
    "check:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json --output-type err",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint apps/api/src apps/checkout/src apps/merchant-studio/src apps/merchant-dashboard/src packages --no-warn-ignored"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "dependency-cruiser": "^18.3.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.4",
    "globals": "16.4.0",
    "jose": "6.2.8",
    "shadcn": "^4.16.2",
    "svgo": "4.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.3"
  }
}
