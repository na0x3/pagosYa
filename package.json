{
  "name": "pagosya",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:db": "node scripts/dev-db.mjs start",
    "dev:db:stop": "node scripts/dev-db.mjs stop",
    "dev:dashboard": "pnpm --filter @pagosya/merchant-dashboard run dev",
    "dev:studio": "pnpm --filter @pagosya/merchant-studio run dev",
    "storefront:source": "node scripts/storefront-source.mjs",
    "dev:consumer": "pnpm --filter @pagosya/consumer-dashboard run dev",
    "demo:store": "node scripts/demo-store.mjs",
    "demo:inventory-db": "node examples/cafe-aroma/setup.mjs",
    "demo:inventory-stock": "node examples/cafe-aroma/update-stock.mjs",
    "demo:inventory-sync": "node examples/cafe-aroma/sync-stock.mjs",
    "demo:subscriptions-sync": "node examples/cafe-aroma/sync-subscriptions.mjs",
    "verify:events": "node scripts/verify-events-demo.mjs",
    "verify:face-entry": "node scripts/verify-reusable-face-entry.mjs",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev:independent-cafe": "node examples/independent-cafe/build.mjs && node examples/independent-cafe/server.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "shadcn": "^4.16.2",
    "typescript": "^5.6.3"
  }
}
