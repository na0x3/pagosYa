+.lb-stepp__tabs button{min-height:36px;padding:0 14px;border:1px solid color-mix(in srgb,var(--es-ink) 22%,transparent);border-radius:999px;background:transparent;color:inherit;font:500 13px/1 var(--es-body);cursor:pointer;transition:background-color .2s ease,color .2s ease}
+.lb-stepp__tabs button[aria-selected="true"]{border-color:var(--es-ink);background:var(--es-ink);color:var(--es-paper)}
+.lb-stepp__body{position:relative;display:grid;align-content:end;gap:14px}
+.lb-stepp__body .lb-eyebrow{margin:0}
+.lb-stepp__text{margin:0;padding-right:64px;font:400 clamp(26px,2.6vw,40px)/1.22 var(--es-heading);letter-spacing:-.01em;text-wrap:pretty}
+.lb-stepp__text sup{margin-right:4px;font:500 14px/1 var(--es-body);vertical-align:top;opacity:.6}
+.lb-stepp__next{position:absolute;right:0;bottom:0;display:grid;place-items:center;width:50px;height:50px;padding:0;border:1px solid color-mix(in srgb,var(--es-ink) 35%,transparent);border-radius:50%;background:transparent;color:inherit;cursor:pointer;transition:background-color .2s ease,color .2s ease,transform .2s ease}
+.lb-stepp__next svg{width:20px;height:20px}
+.lb-stepp__next:hover{background:var(--es-ink);color:var(--es-paper)}
+.lb-stepp__next:active{transform:scale(.94)}
+/* The photo panel is as wide as the photo at the card's height: whole, no bars. */
+.lb-stepp__media{height:clamp(360px,38vw,600px);max-width:min(58vw,820px);border-radius:26px;overflow:hidden;background:var(--es-muted)}
+.lb-stepp__media img{display:block;width:auto;max-width:100%;height:100%;object-fit:contain}
+@media (max-width:760px){.lb-stepp{grid-template-columns:minmax(0,1fr)}.lb-stepp__media{order:-1;height:auto;max-width:none}.lb-stepp__media img{width:100%;height:auto}.lb-stepp__card{min-height:0}}
+/* /lb:steps-howto */
+
+/* Hollow white buttons (owner 2026-11-13): on a hero over a photo or a dark backdrop, the buttons are white outlines, filled on hover. */
+.es .lb-cover:is(.lb-cover--dark,[data-ground="dark"]) .lb-actions .es-btn{background:transparent;border:1.5px solid #fff;color:#fff;box-shadow:none}
+.es .lb-cover:is(.lb-cover--dark,[data-ground="dark"]) .lb-actions .es-btn:hover{background:#fff;color:#151515}
+.es .lb-cover:is(.lb-cover--dark,[data-ground="dark"]) .lb-actions .lb-btn:first-child svg{background:transparent;color:inherit;box-shadow:inset 0 0 0 1.5px currentColor}
+
+/* Owner 2026-11-13 («text on that suppressed header looks bad»): the see-through header rules of the themes need a hero with
+   data-lb-overlap, which none has now — the menu always sits on its own bar.
+   Owner 2026-11-13 (hero on its photo's colour): the words' half takes that colour too, so the hero is one field. */
+.lb-cover[data-ground] :is(.lb-cover-half__panel,.lb-cover-split__copy){background:transparent}
