+/* lb:cover-kinetic,strip-velocity,statement-rotate,story-carousel,tabs-photo */
+/* Rich sections (owner 2026-11-13): the kit's rich pieces as library sections; type and colours stay the template's. */
+.lb-kinetic__copy{width:min(1100px,100%);margin:0 auto;padding:clamp(56px,8vw,120px) 24px clamp(28px,4vw,56px)}
+.lb-kinetic__title{margin:0;max-width:16ch;font-family:var(--es-heading);text-wrap:balance}
+/* The moving cover is light: the themes that clear their header over a photo cover (Impulse, Motion, Amigos) keep it solid
+ * over this one (selectors use .lb-cover:not(.lb-cover-kinetic), owner 2026-11-13 Remolino). */
+/* Beats a theme's plain .lb-title size (Botica 26–36px): this cover's headline is the page's largest words in every template. */
+.lb.lb-cover-kinetic .lb-kinetic__title{font-size:clamp(40px,6vw,80px);line-height:1.02}
+.lb-kinetic__copy .lb-eyebrow{margin-bottom:18px}
+/* Whole photos (owner 2026-11-13 «dont let yapi crop pictures»): the photo's own shape, never cut, never wider than it is. */
+.lb-whole{display:block;width:auto;height:auto;max-width:100%;margin-inline:auto;border-radius:var(--lb-r-lg)}
+.lb-kinetic__media{width:min(1100px,calc(100% - 48px));margin:0 auto clamp(48px,6vw,88px)}
+.lb-kinetic__media .lb-whole{max-height:76vh}
+.lb-rotate{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(28px,6vw,96px);align-items:center}
+.lb-rotate[data-lb-side=left] .lb-rotate__media{order:-1}
+.lb-rotate__title{margin:0;text-wrap:balance}
+.lb-rotate__word{color:var(--es-accent)}
+[data-es-band=accent] .lb-rotate__word,[data-es-band=deep] .lb-rotate__word{color:inherit;text-decoration:underline;text-decoration-thickness:.06em;text-underline-offset:.12em}
+.lb-rotate__copy .lb-lede{margin-top:20px}
+.lb-rotate__media{margin:0;width:min(520px,100%);justify-self:center}
+.lb-rotate__media .lb-whole{max-height:70vh}
+.lb-carousel{margin-top:clamp(20px,3vw,36px)}
+.lb-carousel .ui-k-carousel__track{border-radius:var(--lb-r-lg)}
+/* One frame for every slide; each photo shows whole inside it on the store's soft ground. */
+.lb-carousel .ui-k-carousel__slide{background:var(--es-muted,#eee)}
+.lb-carousel .ui-k-carousel__slide img{object-fit:contain}
+.lb-carousel .ui-k-carousel__copy a{color:#fff;font-weight:600;text-decoration:underline;text-underline-offset:4px}
+.lb-tabs{margin-top:clamp(16px,2.5vw,28px)}
+.lb-tabs .ui-k-tabs__list{justify-content:flex-start;gap:10px}
+.lb-tabs .ui-k-tabs__list .ui-k-tabs__tab{min-height:44px;padding:10px 22px;border:1px solid var(--lb-line);border-radius:999px;background:transparent;color:var(--es-ink);font:500 15px/1.2 var(--es-body);letter-spacing:0;text-transform:none;box-shadow:none}
+.lb-tabs .ui-k-tabs__list .ui-k-tabs__tab[aria-selected="true"]{background:var(--es-accent);border-color:var(--es-accent);color:var(--es-on-accent)}
+.lb-tabs__panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,5vw,72px);align-items:center}
+.lb-tabs__photo{margin:0}
+.lb-tabs__photo .lb-whole{max-height:62vh}
+.lb-tabs__lead{margin:0 0 18px;max-width:34ch;font:500 clamp(20px,2vw,28px)/1.35 var(--es-heading);text-wrap:pretty}
+.lb-strip-velocity{overflow:hidden;padding:clamp(14px,2vw,22px) 0;background:var(--es-paper);color:var(--es-ink);border-block:1px solid var(--lb-line)}
+.lb-strip-velocity[data-lb-band=accent]{background:var(--es-accent);color:var(--es-on-accent);border:0}
+.lb-strip-velocity[data-lb-band=deep]{background:var(--es-deep);color:var(--es-paper);border:0}
+.lb-velocity__line{display:flex;gap:40px;margin:0;white-space:nowrap;font:600 clamp(28px,4vw,56px)/1.1 var(--es-heading);letter-spacing:-.01em}
+.lb-velocity__line span{display:inline-flex;align-items:center;gap:40px}
+.lb-velocity__line i{font-style:normal;font-size:.45em;color:var(--es-accent)}
+.lb-strip-velocity[data-lb-band] .lb-velocity__line i{color:inherit;opacity:.7}
+@media (max-width:760px){
+  .lb-rotate,.lb-tabs__panel{grid-template-columns:1fr}
