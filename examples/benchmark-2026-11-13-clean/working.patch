+/* /lb:cover-kinetic,strip-velocity,statement-rotate,story-carousel,tabs-photo */
+
+/* Hero kit + cards (owner 2026-11-13 «better inside of product cards, better looking buttons, no tiene que verse apagado, more
+ * modern design luxury», after Amboras's heroes). */
+/* Product cards: the add button is the brand's solid colour, never a grey outline; price reads first after the name. */
+.lb-card .es-card__add{border:0;background:var(--es-accent);color:var(--es-on-accent);box-shadow:0 10px 22px -12px color-mix(in srgb,var(--es-accent) 80%,#000);transition:transform .2s cubic-bezier(.2,.7,.2,1),box-shadow .2s,filter .2s}
+.lb-card .es-card__add:hover{background:var(--es-accent);color:var(--es-on-accent);transform:translateY(-1px) scale(1.06);filter:brightness(1.06);box-shadow:0 14px 26px -12px color-mix(in srgb,var(--es-accent) 85%,#000)}
+.lb-card .es-card__add:active,.lb-card .lb-card__buy:active{transform:scale(.96)}
+.lb-card .lb-card__buy{border:0;background:var(--es-accent);color:var(--es-on-accent);transition:transform .2s cubic-bezier(.2,.7,.2,1),filter .2s,box-shadow .2s}
+.lb-card .lb-card__buy:hover{filter:brightness(1.06);box-shadow:0 14px 26px -14px color-mix(in srgb,var(--es-accent) 85%,#000)}
+.lb-card .es-card__price{font-size:clamp(15px,1.15vw,17px);font-weight:650;letter-spacing:-.005em}
+.lb-card .es-card__media img{transition:transform .6s cubic-bezier(.2,.7,.2,1)}
+.lb-card:hover .es-card__media img{transform:scale(1.035)}
+@media (prefers-reduced-motion:reduce){.lb-card .es-card__add,.lb-card .lb-card__buy,.lb-card .es-card__media img{transition:none}.lb-card:hover .es-card__media img{transform:none}}
+/* Cover words: the place label in a spaced monospace, the main button a pill with its arrow in a dark circle. */
+:is(.lb-cover,.lb-hero-split) :is(.lb-eyebrow,.lb-hero-split__eyebrow){font-family:ui-monospace,"SF Mono",SFMono-Regular,Menlo,Consolas,monospace;font-weight:500;font-size:clamp(11px,.9vw,13px);letter-spacing:.22em;text-transform:uppercase}
+.es:not([data-es-button="underline"]) .lb-cover .lb-actions .lb-btn:first-child{padding-right:7px;gap:16px}
+.es:not([data-es-button="underline"]) .lb-cover .lb-actions .lb-btn:first-child svg{box-sizing:border-box;width:38px;height:38px;padding:10px;border-radius:50%;background:var(--es-ink);color:var(--es-paper);flex:none}
+.es:not([data-es-button="underline"]) .lb-cover--dark .lb-actions .lb-btn:first-child svg,.es:not([data-es-button="underline"]) .lb-cover .lb-actions .es-btn--ink:first-child svg{background:var(--es-accent);color:var(--es-on-accent)}
+/* On a photo cover the accent word must read over the photo: a light tint of the accent. */
+.lb-cover--dark :is(h1,.lb-title,.lb-stage__title) .lb-em{color:color-mix(in srgb,var(--es-accent) 45%,#fff)}
