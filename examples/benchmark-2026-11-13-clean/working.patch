+/* lb:heroshop */
+/* The hero shop: real products on the cover. Floating over a photo cover's corner, or a row under the words. */
+.lb-heroshop{position:relative;z-index:2}
+.lb-heroshop[data-place="float"]{position:absolute;right:clamp(16px,3vw,40px);bottom:clamp(16px,3vw,40px);width:min(400px,calc(100% - 32px))}
+.lb-heroshop[data-place="row"]{width:min(1280px,100%);margin:0 auto;padding:0 24px clamp(32px,4vw,56px)}
+.lb-hero-split__panel .lb-heroshop[data-place="row"]{width:100%;padding:24px 0 0}
+.lb-heroshop .lb-heroshop__cards{display:grid;gap:10px;grid-template-columns:1fr}
+.lb-heroshop[data-place="row"] .lb-heroshop__cards{grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}
+.lb-heroshop .lb-card{display:grid;grid-template-columns:64px minmax(0,1fr);align-items:center;gap:14px;margin:0;padding:10px 12px 10px 10px;border:0;border-radius:18px;background:var(--es-paper);color:var(--es-ink);box-shadow:0 22px 44px -26px rgb(0 0 0 / .5);min-height:0;height:auto;text-align:left}
+.lb-heroshop .lb-card__media{display:block;width:64px;height:64px;margin:0;padding:0;aspect-ratio:1;border-radius:12px;overflow:hidden;background:var(--es-muted)}
+.lb-heroshop .lb-card__media img{width:100%;height:100%;object-fit:contain;border-radius:0}
+.lb-heroshop .lb-card__body{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:2px 12px;margin:0;padding:0;background:none;text-align:left}
+.lb-heroshop .lb-card :is(.lb-card__body,.es-card__name,.es-card__price,.es-card__add,.lb-card__buy){position:static;transform:none;inset:auto}
+.lb-heroshop .es-card__row{display:contents}
+.lb-heroshop .lb-card .es-card__name{grid-column:1;margin:0;font:600 15px/1.25 var(--es-body);letter-spacing:0;text-transform:none;color:inherit;text-shadow:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.lb-heroshop .lb-card .es-card__price{grid-column:1;margin:0;font:500 13px/1.3 var(--es-body);opacity:.72}
