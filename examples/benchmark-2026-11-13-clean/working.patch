+/* lb:steps-howto */
+/* Steps as panels (owner 2026-11-13, Clyro «(01) Application»): one step in large type on a soft panel, the photo whole beside it. */
+.lb-stepp{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(12px,1.6vw,24px)}
+.lb-stepp--plain{grid-template-columns:minmax(0,1fr);max-width:820px;margin-inline:auto}
